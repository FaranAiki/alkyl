import "std/print";
errnum[ErrTwo, ErrThree, ErrNotOne]
tainted int hasError(int a) {
    if a == 1 then return 1;
    if a == 2 then purge ErrTwo;
    if a == 3 then purge ErrThree;
    purge ErrNotOne;
}
int main() {
    let z = hasError(3);
    let r1 = z ?[ErrThree] 42;
    let r2 = r1 ? 100;
    if (r2 == 42) {
        std.print "IT IS 42\n";
    }
    if (r2 == 100) {
        std.print "IT IS 100\n";
    }
    if (r2 == 3) {
        std.print "IT IS 3\n";
    }
}
