/* Premeta stuff */
define noreason as reason "No reason";
premeta {
    define noreason as reason "No reason";
}

/* For synthetic grammar I guess */
define prist as pristine;
define taint as tainted;

/* This is for simplification OOP if needed */
define trait as abstract method class;
define struct as abstract container class;
define impl as exact method class;

/* This is for simplification of mutability/immutability if needed */
define immutable as imut;
define mutable as mut;
define auto as let;

/* Type definitions */
typedef i0 as void;
typedef u0 as void;
typedef i32 as int;
typedef u32 as unsigned int;
typedef i64 as long;
typedef u64 as unsigned long;
typedef i128 as long long;
typedef u128 as unsigned long long;
typedef f32 as single;
typedef f64 as double;
// typedef f128 as long double; // NOT yet implemented

/* We still prefer single instead of float */
typedef float as single;

/* Literal and pointer literal */
define Literal as
    i0, u0, i32, u32,
    i64, u64, i128, u128,
    f32, f64;

define PointerLiteral as
    i0*, u0*, i32*, u32*,
    i64*, u64*, i128*, u128*,
    f32*, f64*;

define ArrayLiteral as
    i0[], u0[], i32[], u32[],
    i64[], u64[], i128[], u128[],
    f32[], f64[];

/* Syntatic sugar */
define otherwise as ?;
define catch as ?;
define final as closed;
define throw as purge;
define raise as purge;
