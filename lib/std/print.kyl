// TODO make sure that this does not heavily depends on clib!
// do an abstraction!

namespace __c_lib {
  extern int printf(char*, ...);
  extern int putchar(int);
  extern int puts(char*);
}

define formatted_printf as __c_lib.printf;
define putchar as __c_lib.putchar;

namespace std {

void print_int_array(int arr[], unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        formatted_printf("%d", arr[i]);
        if (i < size - 1) { formatted_printf("%s", ", "); }
        i += 1;
    }
    putchar(']');
}

void print_uint_array(unsigned int arr[], unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        formatted_printf("%u", arr[i]);
        if (i < size - 1) { formatted_printf("%s", ", "); }
        i += 1;
    }
    putchar(']');
}

void print_long_array(void* arr, unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        formatted_printf("%ld", (arr as long*)[i]);
        if (i < size - 1) { formatted_printf("%s", ", "); }
        i += 1;
    }
    putchar(']');
}

void print_ulong_array(void* arr, unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        formatted_printf("%lu", (arr as unsigned long*)[i]);
        if (i < size - 1) { formatted_printf("%s", ", "); }
        i += 1;
    }
    putchar(']');
}

void print_single_array(void* arr, unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        formatted_printf("%f", (arr as single*)[i]);
        if (i < size - 1) { formatted_printf("%s", ", "); }
        i += 1;
    }
    putchar(']');
}

void print_double_array(void* arr, unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        formatted_printf("%lf", (arr as double*)[i]);
        if (i < size - 1) { formatted_printf("%s", ", "); }
        i += 1;
    }
    putchar(']');
}

// TODO: make sure that meta can accepts optional params, e.g.
// print(..., sep='', end='\n', file=stdout, flush=1)
// and yes, this implementation is so slow!
// make sure that this is not that slow
meta void print(...) {
    for arg in ... {
        if (typeof(arg) == typeof(int)) {
            formatted_printf("%d", arg);
        } else if (typeof(arg) == typeof(unsigned int)) {
            formatted_printf("%u", arg);
        } else if (typeof(arg) == typeof(long)) {
            formatted_printf("%ld", arg);
        } else if (typeof(arg) == typeof(unsigned long)) {
            formatted_printf("%lu", arg);
        } else if (typeof(arg) == typeof(single)) {
            formatted_printf("%f", arg);
        } else if (typeof(arg) == typeof(double)) {
            formatted_printf("%lf", arg);
        } else if (typeof(arg) == typeof(char)) {
            if (sizeof(arg) == 1) {
                formatted_printf("%c", arg);
            } else {
                formatted_printf("%s", arg);
            }
        } else if (typeof(arg) == typeof(int[])) {
            print_int_array(arg, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(unsigned int[])) {
            print_uint_array(arg, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(long[])) {
            print_long_array(arg, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(unsigned long[])) {
            print_ulong_array(arg, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(single[])) {
            print_single_array(arg, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(double[])) {
            print_double_array(arg, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(char*)) {
            formatted_printf("%s", arg);
        } else {
            // formatted_printf("%p ", arg);
            // This should raise an error!
        }
    }
    // formatted_printf("%s", "\n");
}

}
