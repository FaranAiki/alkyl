// TODO make sure that this does not heavily depends on clib!
// do an abstraction!

namespace __c_lib {
  extern int putchar(int);
  extern int puts(char*);
  extern void alkyl_print_str(char*);
  extern void alkyl_print_char(char);
  extern void alkyl_print_i64(long);
  extern void alkyl_print_u64(unsigned long);
  extern void alkyl_print_i32(int);
  extern void alkyl_print_u32(unsigned int);
  extern void alkyl_print_f32(single);
  extern void alkyl_print_f64(double);
}
define putchar as __c_lib.putchar;

namespace std {

void print_int_array(int arr[], unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        __c_lib.alkyl_print_i32(arr[i]);
        if (i < size - 1) { __c_lib.alkyl_print_str(", "); }
        i += 1;
    }
    putchar(']');
}

void print_uint_array(unsigned int arr[], unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        __c_lib.alkyl_print_u32(arr[i]);
        if (i < size - 1) { __c_lib.alkyl_print_str(", "); }
        i += 1;
    }
    putchar(']');
}

void print_long_array(void* arr, unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        __c_lib.alkyl_print_i64((arr as long*)[i]);
        if (i < size - 1) { __c_lib.alkyl_print_str(", "); }
        i += 1;
    }
    putchar(']');
}

void print_ulong_array(void* arr, unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        __c_lib.alkyl_print_u64((arr as unsigned long*)[i]);
        if (i < size - 1) { __c_lib.alkyl_print_str(", "); }
        i += 1;
    }
    putchar(']');
}

void print_single_array(void* arr, unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        __c_lib.alkyl_print_f32((arr as single*)[i]);
        if (i < size - 1) { __c_lib.alkyl_print_str(", "); }
        i += 1;
    }
    putchar(']');
}

void print_double_array(void* arr, unsigned long size) {
    putchar('[');
    unsigned long i = 0;
    while (i < size) {
        __c_lib.alkyl_print_f64((arr as double*)[i]);
        if (i < size - 1) { __c_lib.alkyl_print_str(", "); }
        i += 1;
    }
    putchar(']');
}

// TODO: make sure that meta can accepts optional params, e.g.
// print(..., sep='', end='\n', file=stdout, flush=1)
// and yes, this implementation is so slow!
// make sure that this is not that slow
meta void print(...) {
    for arg in ... {
        if (typeof(arg) == typeof(int)) {
            __c_lib.alkyl_print_i32(arg);
        } else if (typeof(arg) == typeof(unsigned int)) {
            __c_lib.alkyl_print_u32(arg);
        } else if (typeof(arg) == typeof(long)) {
            __c_lib.alkyl_print_i64(arg);
        } else if (typeof(arg) == typeof(unsigned long)) {
            __c_lib.alkyl_print_u64(arg);
        } else if (typeof(arg) == typeof(single)) {
            __c_lib.alkyl_print_f32(arg);
        } else if (typeof(arg) == typeof(double)) {
            __c_lib.alkyl_print_f64(arg);
        } else if (typeof(arg) == typeof(char)) {
            if (sizeof(arg) == 1) {
                __c_lib.alkyl_print_char(arg);
            } else {
                __c_lib.alkyl_print_str(arg);
            }
        } else if (typeof(arg) == typeof(int[])) {
            print_int_array(arg, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(unsigned int[])) {
            print_uint_array(arg, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(long[])) {
            print_long_array(arg, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(unsigned long[])) {
            print_ulong_array(arg, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(single[])) {
            print_single_array(arg, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(double[])) {
            print_double_array(arg, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(char*)) {
            __c_lib.alkyl_print_str(arg);
        } else {
            // formatted_printf("%p ", arg);
            // This should raise an error!
        }
    }
    // __c_lib.alkyl_print_str("\n");
}

}
