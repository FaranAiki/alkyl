extern int printf(char* fmt, ...) as cprintf;

void print_int_array(int* arr, long size) {
    cprintf("%s", "[ ");
    let i = 0;
    while (i < size) {
        cprintf("%d", arr[i]);
        if (i < size - 1) { cprintf("%s", ", "); }
        i += 1;
    }
    cprintf("%s", " ] ");
}

void print_uint_array(unsigned int* arr, long size) {
    cprintf("%s", "[ ");
    let i = 0;
    while (i < size) {
        cprintf("%u", arr[i]);
        if (i < size - 1) { cprintf("%s", ", "); }
        i += 1;
    }
    cprintf("%s", " ] ");
}

void print_long_array(long* arr, long size) {
    cprintf("%s", "[ ");
    let i = 0;
    while (i < size) {
        cprintf("%ld", arr[i]);
        if (i < size - 1) { cprintf("%s", ", "); }
        i += 1;
    }
    cprintf("%s", " ] ");
}

void print_ulong_array(unsigned long* arr, long size) {
    cprintf("%s", "[ ");
    let i = 0;
    while (i < size) {
        cprintf("%lu", arr[i]);
        if (i < size - 1) { cprintf("%s", ", "); }
        i += 1;
    }
    cprintf("%s", " ] ");
}

void print_single_array(single* arr, long size) {
    cprintf("%s", "[ ");
    let i = 0;
    while (i < size) {
        cprintf("%f", arr[i]);
        if (i < size - 1) { cprintf("%s", ", "); }
        i += 1;
    }
    cprintf("%s", " ] ");
}

void print_double_array(double* arr, long size) {
    cprintf("%s", "[ ");
    let i = 0;
    while (i < size) {
        cprintf("%lf", arr[i]);
        if (i < size - 1) { cprintf(", "); }
        i += 1;
    }
    cprintf(" ] ");
}


meta void print(...) {
    for arg in ... {
        if (typeof(arg) == typeof(int)) {
            cprintf("%d ", arg);
        } else if (typeof(arg) == typeof(unsigned int)) {
            cprintf("%u ", arg);
        } else if (typeof(arg) == typeof(long)) {
            cprintf("%ld ", arg);
        } else if (typeof(arg) == typeof(unsigned long)) {
            cprintf("%lu ", arg);
        } else if (typeof(arg) == typeof(single)) {
            cprintf("%f ", arg);
        } else if (typeof(arg) == typeof(double)) {
            cprintf("%lf ", arg);
        } else if (typeof(arg) == typeof(char)) {
            if (sizeof(arg) == 1) {
                cprintf("%c ", arg);
            } else {
                cprintf("%s ", arg);
            }
        } else if (typeof(arg) == typeof(int[])) {
            print_int_array(arg as int*, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(unsigned int[])) {
            print_uint_array(arg as unsigned int*, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(long[])) {
            print_long_array(arg as long*, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(unsigned long[])) {
            print_ulong_array(arg as unsigned long*, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(single[])) {
            print_single_array(arg as single*, sizeof(arg) >> 2);
        } else if (typeof(arg) == typeof(double[])) {
            print_double_array(arg as double*, sizeof(arg) >> 3);
        } else if (typeof(arg) == typeof(char*)) {
            cprintf("%s ", arg);
        } else {
            cprintf("%p ", arg);
        }
    }
    cprintf("%s", "\n");
}
