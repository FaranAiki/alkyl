define _r_fma as __raw_math.fma;

define _r_ilogb as __raw_math.ilogb;
define _r_scalbn as __raw_math.scalbn;
define _r_scalbln as __raw_math.scalbln;

define _r_sinf as __raw_math.sinf;
define _r_cosf as __raw_math.cosf;
define _r_tanf as __raw_math.tanf;
define _r_asinf as __raw_math.asinf;
define _r_acosf as __raw_math.acosf;
define _r_atanf as __raw_math.atanf;
define _r_atan2f as __raw_math.atan2f;

define _r_sinhf as __raw_math.sinhf;
define _r_coshf as __raw_math.coshf;
define _r_tanhf as __raw_math.tanhf;

define _r_expf as __raw_math.expf;
define _r_exp2f as __raw_math.exp2f;
define _r_expm1f as __raw_math.expm1f;
define _r_logf as __raw_math.logf;
define _r_log10f as __raw_math.log10f;
define _r_log2f as __raw_math.log2f;
define _r_log1pf as __raw_math.log1pf;

define _r_powf as __raw_math.powf;
define _r_sqrtf as __raw_math.sqrtf;
define _r_cbrtf as __raw_math.cbrtf;
define _r_hypotf as __raw_math.hypotf;

define _r_erff as __raw_math.erff;
define _r_erfcf as __raw_math.erfcf;
define _r_lgammaf as __raw_math.lgammaf;
define _r_tgammaf as __raw_math.tgammaf;

