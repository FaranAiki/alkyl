link m;

private namespace __raw_math {
    reason "math library" pure extern {

    double sin(double);
    double cos(double);
    double tan(double);
    double asin(double);
    double acos(double);
    double atan(double);
    double atan2(double, double);

    double sinh(double);
    double cosh(double);
    double tanh(double);

    double exp(double);
    double exp2(double);
    double expm1(double);
    double log(double);
    double log10(double);
    double log2(double);
    double log1p(double);

    double pow(double, double);
    double sqrt(double);
    double cbrt(double);
    double hypot(double, double);

    double erf(double);
    double erfc(double);
    double lgamma(double);
    double tgamma(double);

    double ceil(double);
    double floor(double);
    double round(double);
    double trunc(double);
    double nearbyint(double);
    double rint(double);

    double fabs(double);
    double fmod(double, double);
    double fmax(double, double);
    double fmin(double, double);
    double remainder(double, double);
    double copysign(double, double);

    double frexp(double, int*);
    double modf(double, double*);

    double nextafter(double, double);
    double fma(double, double, double);

    int ilogb(double);
    double scalbn(double, int);
    double scalbln(double, long);

    single sinf(single);
    single cosf(single);
    single tanf(single);
    single asinf(single);
    single acosf(single);
    single atanf(single);
    single atan2f(single, single);

    single sinhf(single);
    single coshf(single);
    single tanhf(single);

    single expf(single);
    single exp2f(single);
    single expm1f(single);
    single logf(single);
    single log10f(single);
    single log2f(single);
    single log1pf(single);

    single powf(single, single);
    single sqrtf(single);
    single cbrtf(single);
    single hypotf(single, single);

    single erff(single);
    single erfcf(single);
    single lgammaf(single);
    single tgammaf(single);

    single ceilf(single);
    single floorf(single);
    single roundf(single);
    single truncf(single);
    single nearbyintf(single);
    single rintf(single);

    single fabsf(single);
    single fmodf(single, single);
    single fmaxf(single, single);
    single fminf(single, single);
    single remainderf(single, single);
    single copysignf(single, single);

    single frexpf(single, int*);
    single modff(single, single*);

    single nextafterf(single, single);
    single fmaf(single, single, single);

    int ilogbf(single);
    single scalbnf(single, int);
    single scalblnf(single, long);
    }
}

/* static define */
define _r_sin as __raw_math.sin;
define _r_cos as __raw_math.cos;
define _r_tan as __raw_math.tan;
define _r_asin as __raw_math.asin;
define _r_acos as __raw_math.acos;
define _r_atan as __raw_math.atan;
define _r_atan2 as __raw_math.atan2;

define _r_sinh as __raw_math.sinh;
define _r_cosh as __raw_math.cosh;
define _r_tanh as __raw_math.tanh;

define _r_exp as __raw_math.exp;
define _r_exp2 as __raw_math.exp2;
define _r_expm1 as __raw_math.expm1;
define _r_log as __raw_math.log;
define _r_log10 as __raw_math.log10;
define _r_log2 as __raw_math.log2;
define _r_log1p as __raw_math.log1p;

define _r_pow as __raw_math.pow;
define _r_sqrt as __raw_math.sqrt;
define _r_cbrt as __raw_math.cbrt;
define _r_hypot as __raw_math.hypot;

define _r_erf as __raw_math.erf;
define _r_erfc as __raw_math.erfc;
define _r_lgamma as __raw_math.lgamma;
define _r_tgamma as __raw_math.tgamma;

