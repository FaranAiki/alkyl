define _r_scalblnf as __raw_math.scalblnf;

/* export */ public open namespace math {

const double pi = 3.14159265358979323846;
// const Complex i = Complex();

pure {
double atan2(double y, double x) { return _r_atan2(y, x); }
single atan2(single y, single x) { return _r_atan2f(y, x); }

single sin(single n) { return _r_sinf(n); }
single cos(single n) { return _r_cosf(n); }
single tan(single n) { return _r_tanf(n); }

double sin(double n) { return _r_sin(n); }
double cos(double n) { return _r_cos(n); }
double tan(double n) { return _r_tan(n); }

single asin(single n) { return _r_asinf(n); }
single acos(single n) { return _r_acosf(n); }
single atan(single n) { return _r_atanf(n); }

double asin(double n) { return _r_asin(n); }
double acos(double n) { return _r_acos(n); }
double atan(double n) { return _r_atan(n); }

single sinh(single n) { return _r_sinhf(n); }
single cosh(single n) { return _r_coshf(n); }
single tanh(single n) { return _r_tanhf(n); }

double sinh(double n) { return _r_sinh(n); }
double cosh(double n) { return _r_cosh(n); }
double tanh(double n) { return _r_tanh(n); }

single exp(single n) { return _r_expf(n); }
single exp2(single n) { return _r_exp2f(n); }
single expm1(single n) { return _r_expm1f(n); }

double exp(double n) { return _r_exp(n); }
double exp2(double n) { return _r_exp2(n); }
double expm1(double n) { return _r_expm1(n); }

single log(single n) { return _r_logf(n); }
single log10(single n) { return _r_log10f(n); }
single log2(single n) { return _r_log2f(n); }
single log1p(single n) { return _r_log1pf(n); }

double log(double n) { return _r_log(n); }
double log10(double n) { return _r_log10(n); }
double log2(double n) { return _r_log2(n); }
double log1p(double n) { return _r_log1p(n); }

single pow(single a, single b) { return _r_powf(a, b); }
single sqrt(single n) { return _r_sqrtf(n); }
single cbrt(single n) { return _r_cbrtf(n); }
single hypot(single a, single b) { return _r_hypotf(a, b); }

double pow(double a, double b) { return _r_pow(a, b); }
double sqrt(double n) { return _r_sqrt(n); }
double cbrt(double n) { return _r_cbrt(n); }
double hypot(double a, double b) { return _r_hypot(a, b); }

single erf(single n) { return _r_erff(n); }
single erfc(single n) { return _r_erfcf(n); }
single lgamma(single n) { return _r_lgammaf(n); }
single tgamma(single n) { return _r_tgammaf(n); }

double erf(double n) { return _r_erf(n); }
double erfc(double n) { return _r_erfc(n); }
double lgamma(double n) { return _r_lgamma(n); }
double tgamma(double n) { return _r_tgamma(n); }

single ceil(single n) { return _r_ceilf(n); }
single floor(single n) { return _r_floorf(n); }
single round(single n) { return _r_roundf(n); }
single trunc(single n) { return _r_truncf(n); }
single nearbyint(single n) { return _r_nearbyintf(n); }
single rint(single n) { return _r_rintf(n); }

double ceil(double n) { return _r_ceil(n); }
double floor(double n) { return _r_floor(n); }
double round(double n) { return _r_round(n); }
double trunc(double n) { return _r_trunc(n); }
double nearbyint(double n) { return _r_nearbyint(n); }
double rint(double n) { return _r_rint(n); }

single abs(single n) { return _r_fabsf(n); }
double abs(double n) { return _r_fabs(n); }

single fmod(single a, single b) { return _r_fmodf(a, b); }
single fmax(single a, single b) { return _r_fmaxf(a, b); }
single fmin(single a, single b) { return _r_fminf(a, b); }
single remainder(single a, single b) { return _r_remainderf(a, b); }

double fmod(double a, double b) { return _r_fmod(a, b); }
double fmax(double a, double b) { return _r_fmax(a, b); }
double fmin(double a, double b) { return _r_fmin(a, b); }
double remainder(double a, double b) { return _r_remainder(a, b); }

single nextafter(single from, single to) { return _r_nextafterf(from, to); }
single fma(single a, single b, single c) { return _r_fmaf(a, b, c); }

double nextafter(double from, double to) { return _r_nextafter(from, to); }
double fma(double a, double b, double c) { return _r_fma(a, b, c); }

int ilogb(double n) { return _r_ilogb(n); }
int ilogb(single n) { return _r_ilogbf(n); }

single scalbn(single n, int result_exp) { return _r_scalbnf(n, result_exp); }
double scalbn(double n, int result_exp) { return _r_scalbn(n, result_exp); }

single scalbln(single n, long result_exp) { return _r_scalblnf(n, result_exp); }
double scalbln(double n, long result_exp) { return _r_scalbln(n, result_exp); }

single copysign(single mag, single sgn) { return _r_copysignf(mag, sgn); }
double copysign(double mag, double sgn) { return _r_copysign(mag, sgn); }
}

compound[type Type] abstract container class frexp_result {
    Type mantissa;
    int exponent;
}

compound[type Type] abstract container class modf_result {
    Type integral;
    Type fractional;
}

pure frexp_result[single] frexp(single value) {
    int exponent;
    single mantissa = _r_frexpf(value, &exponent);
    return frexp_result[single](mantissa, exponent);
}

pure frexp_result[double] frexp(double value) {
    int exponent;
    double mantissa = _r_frexp(value, &exponent);
    return frexp_result[double](mantissa, exponent);
}

pure modf_result[single] modf(single value) {
    single intg;
    single frac = _r_modff(value, &intg);
    return modf_result[single](intg, frac);
}

pure modf_result[double] modf(double value) {
    double intg;
    double frac = _r_modf(value, &intg);
    return modf_result[double](intg, frac);
}

// TODO maybe use define or some
pure single factorial(single n) {
    return tgamma(n + 1);
}

pure double factorial(double n) {
    return tgamma(n + 1);
}

define gamma as tgamma;

}
