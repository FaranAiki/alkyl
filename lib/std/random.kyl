private namespace __c_lib {
    @c extern impure {
        int rand();
        void srand(unsigned int seed);
        long time(void* tloc);
    }
}

export namespace random {
    void init() {
        __c_lib.srand(__c_lib.time(null) as unsigned int);
    }

    // TODO: make sure that random.random and random.fast_random is different!
    int random() {
        return fast_random();
    }

    double uniform(double min_num, double max_num) {
        return fast_uniform(min_num, max_num);
    }

    int fast_random() {
        return __c_lib.rand();
    }

    double fast_uniform(double min_num, double max_num) {
        // hardcode initially
        RAND_MAX := 2147483647;
        return min_num + ((fast_random() as double) / RAND_MAX) * (max_num - min_num);
    }
}
