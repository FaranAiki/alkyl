private namespace __c_lib {
    @c extern impure {
        int rand();
        void srand(unsigned int seed);
        long time(void* tloc);
    }
}

export namespace random {
    void init() {
        __c_lib.srand(__c_lib.time(0 as void*) as unsigned int);
    }

    int fast_random() {
        return __c_lib.rand();
    }
}
