private namespace {
    import "std/c_alias";
}

/*
    linking for C
*/
link "wayland-server";
link "wlroots-0.18";

// TODO: instead of 0 as void*, maybe use null!
// and yes, when a (tainted) pointer is null in alkyl (w/ no C), it causes ErrNull
// I guess
export namespace wlroots {
    @c import "lib/wlroots/bridge.h"

    class wl_display {}
    class wlr_backend {}
    class wlr_renderer {}
    class wlr_allocator {}
    class wlr_compositor {}
    class wlr_data_device_manager {}
    class wlr_output_layout {}
    class wlr_xdg_shell {}
    class wlr_seat {}

    class wlr_output {}
    class wlr_xdg_surface {}
    class wl_listener {
        void* link_prev;
        void* link_next;
        void* notify;
    }

    // Display
    errnum [ErrDisplayCreation] wlroots.wl_display*? create_display() {
        let display = wl_display_create();
        if (display == 0 as void*) {
            purge ErrDisplayCreation;
        }
        return display as wlroots.wl_display*;
    }

    errnum [ErrSocketCreation] char*? add_socket_auto(pristine wlroots.wl_display* display) {
        let socket = wl_display_add_socket_auto(display);
        if (socket == 0 as void*) {
            purge ErrSocketCreation;
        }
        return socket;
    }

    // Backend
    errnum [ErrBackendCreation] wlroots.wlr_backend*? create_backend(pristine wlroots.wl_display* display) {
        let event_loop = wl_display_get_event_loop(display);
        let backend = wlr_backend_autocreate(event_loop, 0 as void**);
        if (backend == 0 as void*) {
            purge ErrBackendCreation;
        }
        return backend as wlroots.wlr_backend*;
    }

    errnum [ErrBackendStart] bool? start_backend(pristine wlroots.wlr_backend* backend) {
        if (wlr_backend_start(backend) == false) {
            purge ErrBackendStart;
        }
        return true;
    }

    // Renderer
    errnum [ErrRendererCreation] wlroots.wlr_renderer*? create_renderer(pristine wlroots.wlr_backend* backend) {
        let renderer = wlr_renderer_autocreate(backend);
        if (renderer == 0 as void*) {
            purge ErrRendererCreation;
        }
        return renderer as wlroots.wlr_renderer*;
    }

    void init_renderer(pristine wlroots.wlr_renderer* renderer, pristine wlroots.wl_display* display) {
        wlr_renderer_init_wl_display(renderer, display);
    }

    // Allocator
    errnum [ErrAllocatorCreation] wlroots.wlr_allocator*? create_allocator(pristine wlroots.wlr_backend* backend, pristine wlroots.wlr_renderer* renderer) {
        let allocator = wlr_allocator_autocreate(backend, renderer);
        if (allocator == 0 as void*) {
            purge ErrAllocatorCreation;
        }
        return allocator as wlroots.wlr_allocator*;
    }

    // Compositor
    errnum [ErrCompositorCreation] wlroots.wlr_compositor*? create_compositor(pristine wlroots.wl_display* display, pristine wlroots.wlr_renderer* renderer) {
        let compositor = wlr_compositor_create(display, 5, renderer);
        if (compositor == 0 as void*) {
            purge ErrCompositorCreation;
        }
        return compositor as wlroots.wlr_compositor*;
    }

    // Data Device Manager
    errnum [ErrDataDeviceManagerCreation] wlroots.wlr_data_device_manager*? create_data_device_manager(pristine wlroots.wl_display* display) {
        let manager = wlr_data_device_manager_create(display);
        if (manager == 0 as void*) {
            purge ErrDataDeviceManagerCreation;
        }
        return manager as wlroots.wlr_data_device_manager*;
    }

    // Output Layout
    errnum [ErrOutputLayoutCreation] wlroots.wlr_output_layout*? create_output_layout(pristine wlroots.wl_display* display) {
        let layout = wlr_output_layout_create(display);
        if (layout == 0 as void*) {
            purge ErrOutputLayoutCreation;
        }
        return layout as wlroots.wlr_output_layout*;
    }

    // Xdg Shell
    errnum [ErrXdgShellCreation] wlroots.wlr_xdg_shell*? create_xdg_shell(pristine wlroots.wl_display* display, int version) {
        let shell = wlr_xdg_shell_create(display, version);
        if (shell == 0 as void*) {
            purge ErrXdgShellCreation;
        }
        return shell as wlroots.wlr_xdg_shell*;
    }

    // Seat
    errnum [ErrSeatCreation] wlroots.wlr_seat*? create_seat(pristine wlroots.wl_display* display, char* name) {
        let seat = wlr_seat_create(display, name);
        if (seat == 0 as void*) {
            purge ErrSeatCreation;
        }
        return seat as wlroots.wlr_seat*;
    }

    // Run & Destroy
    void run_display(pristine wlroots.wl_display* display) {
        wl_display_run(display);
    }

    void destroy_clients(pristine wlroots.wl_display* display) {
        wl_display_destroy_clients(display);
    }

    void destroy_display(pristine wlroots.wl_display* display) {
        wl_display_destroy(display);
    }

    void destroy_backend(pristine wlroots.wlr_backend* backend) {
        wlr_backend_destroy(backend);
    }
}

    // Listeners
    void init_listener(pristine wlroots.wl_listener* listener, void* notify_func) {
        init_wl_listener(listener, notify_func);
    }
    void backend_on_new_output(pristine wlroots.wlr_backend* backend, pristine wlroots.wl_listener* listener, void* notify_func) {
        wlr_backend_on_new_output(backend, listener, notify_func);
    }
    void output_on_frame(pristine wlroots.wlr_output* output, pristine wlroots.wl_listener* listener, void* notify_func) {
        wlr_output_on_frame(output, listener, notify_func);
    }
    void output_enable_and_commit(pristine wlroots.wlr_output* output, pristine wlroots.wlr_allocator* allocator, pristine wlroots.wlr_renderer* renderer) {
        wlr_output_enable_and_commit(output, allocator, renderer);
    }
    void xdg_shell_on_new_surface(pristine wlroots.wlr_xdg_shell* shell, pristine wlroots.wl_listener* listener, void* notify_func) {
        wlr_xdg_shell_on_new_surface(shell, listener, notify_func);
    }
    void scene_add_xdg_surface(void* scene, pristine wlroots.wlr_xdg_surface* xdg_surface) {
        wlr_scene_add_xdg_surface(scene, xdg_surface);
    }
}
