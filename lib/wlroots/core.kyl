private namespace {
    extern void* malloc(long size);
    extern void free(void* ptr);
}

link "wayland-server";
link "wlroots-0.18";

export namespace wlroots {

    extern wlr_output_layout* wlr_output_layout_create(wl_display* display);
    extern wlr_xdg_shell* wlr_xdg_shell_create(wl_display* display, int version);
    extern wlr_subcompositor* wlr_subcompositor_create(wl_display* display);
    extern void wlr_output_init_render(wlr_output* output, wlr_allocator* allocator, wlr_renderer* renderer);
    extern void wlr_output_state_init(wlr_output_state* state);
    extern void wlr_output_state_set_enabled(wlr_output_state* state, bool enabled);
    extern void wlr_output_state_set_mode(wlr_output_state* state, void* mode);
    extern void* wlr_output_preferred_mode(wlr_output* output);
    extern void wlr_output_commit_state(wlr_output* output, wlr_output_state* state);
    extern void wlr_output_state_finish(wlr_output_state* state);
    extern void wlr_scene_xdg_surface_create(wlr_scene_tree* tree, wlr_xdg_surface* xdg_surface);

    @c import "wlr/backend.h"
    @c import "wlr/render/allocator.h"
    @c import "wlr/render/wlr_renderer.h"
    @c import "wlr/types/wlr_output.h"
    @c import "wlr/types/wlr_xdg_shell.h"
    @c import "wlr/types/wlr_scene.h"
    @c import "wlr/types/wlr_seat.h"
    @c import "wlr/types/wlr_compositor.h"
    @c import "wlr/types/wlr_data_device.h"
    @c import "wayland-server-core.h"

    class wl_list {
        wl_list* prev;
        wl_list* next;
    }
    class wl_signal {
        wl_list listener_list;
    }
    class wl_listener {
        wl_list link_node;
        void* notify;
    }

    void wl_list_insert(wl_list* list, wl_list* elm) {
        elm.prev = list;
        elm.next = list.next;
        list.next = elm;
        elm.next.prev = elm;
    }

    void wl_signal_add(wl_signal* signal, wl_listener* listener) {
        wl_list_insert(signal.listener_list.prev, &(listener.link_node));
    }

    class wl_display {}
    class wlr_backend {}
    class wlr_renderer {}
    class wlr_allocator {}
    class wlr_compositor {}
    class wlr_data_device_manager {}
    class wlr_subcompositor {}
    class wlr_output_layout {}
    class wlr_xdg_shell {}
    class wlr_seat {}
    class wlr_output {}
    class wlr_xdg_surface {}
    class wlr_output_state {}
    class wlr_scene_tree {}
    class wlr_xdg_toplevel {}
    class wlr_scene {}

    // Display
    errnum [ErrDisplayCreation] wl_display*? create_display() {
        let display = wl_display_create();
        if (display == null ? true) {
            purge ErrDisplayCreation;
        }
        return display as wl_display*;
    }

    errnum [ErrSocketCreation] char*? add_socket_auto(pristine wl_display* display) {
        let socket = wl_display_add_socket_auto(display);
        if (socket == null ? true) {
            purge ErrSocketCreation;
        }
        return socket;
    }

    // Backend
    errnum [ErrBackendCreation] wlr_backend*? create_backend(pristine wl_display* display) {
        let event_loop = wl_display_get_event_loop(display);
        let backend = wlr_backend_autocreate(event_loop, null as wlr_backend**);
        if (backend == null ? true) {
            purge ErrBackendCreation;
        }
        return backend as wlr_backend*;
    }

    errnum [ErrBackendStart] bool? start_backend(pristine wlr_backend* backend) {
        if (wlr_backend_start(backend) == false) {
            purge ErrBackendStart;
        }
        return true;
    }

    // Renderer
    errnum [ErrRendererCreation] wlr_renderer*? create_renderer(pristine wlr_backend* backend) {
        let renderer = wlr_renderer_autocreate(backend);
        if (renderer == null ? true) {
            purge ErrRendererCreation;
        }
        return renderer as wlr_renderer*;
    }

    void init_renderer(pristine wlr_renderer* renderer, pristine wl_display* display) {
        wlr_renderer_init_wl_display(renderer, display);
    }

    // Allocator
    errnum [ErrAllocatorCreation] wlr_allocator*? create_allocator(pristine wlr_backend* backend, pristine wlr_renderer* renderer) {
        let allocator = wlr_allocator_autocreate(backend, renderer);
        if (allocator == null ? true) {
            purge ErrAllocatorCreation;
        }
        return allocator as wlr_allocator*;
    }

    // Compositor
    errnum [ErrCompositorCreation] wlr_compositor*? create_compositor(pristine wl_display* display, pristine wlr_renderer* renderer) {
        let compositor = wlr_compositor_create(display, 5, renderer);
        if (compositor == null ? true) {
            purge ErrCompositorCreation;
        }
        return compositor as wlr_compositor*;
    }

    // Data Device Manager
    errnum [ErrDataDeviceManagerCreation] wlr_data_device_manager*? create_data_device_manager(pristine wl_display* display) {
        let manager = wlr_data_device_manager_create(display);
        if (manager == null ? true) {
            purge ErrDataDeviceManagerCreation;
        }
        return manager as wlr_data_device_manager*;
    }

    // Subcompositor
    errnum [ErrSubcompositorCreation] wlr_subcompositor*? create_subcompositor(pristine wl_display* display) {
        let subcompositor = wlr_subcompositor_create(display);
        if (subcompositor == null ? true) {
            purge ErrSubcompositorCreation;
        }
        return subcompositor as wlr_subcompositor*;
    }

    // Output Layout
    errnum [ErrOutputLayoutCreation] wlr_output_layout*? create_output_layout(pristine wl_display* display) {
        let layout = wlr_output_layout_create(display);
        if (layout == null ? true) {
            purge ErrOutputLayoutCreation;
        }
        return layout as wlr_output_layout*;
    }

    // Xdg Shell
    errnum [ErrXdgShellCreation] wlr_xdg_shell*? create_xdg_shell(pristine wl_display* display, int version) {
        let shell = wlr_xdg_shell_create(display, version);
        if (shell == null ? true) {
            purge ErrXdgShellCreation;
        }
        return shell as wlr_xdg_shell*;
    }

    // Seat & Input
    errnum [ErrSeatCreation] wlr_seat*? create_seat(pristine wl_display* display, char* name) {
        let seat = wlr_seat_create(display, name);
        if (seat == null ? true) {
            purge ErrSeatCreation;
        }
        return seat as wlr_seat*;
    }

    @c extern {
        void wlr_seat_set_keyboard(wlr_seat* seat, void* keyboard);
        void wlr_seat_set_capabilities(wlr_seat* seat, int caps);
        void* wlr_keyboard_from_input_device(void* device);
        void* wlr_pointer_from_input_device(void* device);
        
        void wlr_seat_keyboard_notify_key(void* seat, int time_msec, int keycode, int state);
    }

    // Run & Destroy
    void run_display(pristine wl_display* display) {
        wl_display_run(display);
    }

    void destroy_clients(pristine wl_display* display) {
        wl_display_destroy_clients(display);
    }

    void destroy_display(pristine wl_display* display) {
        wl_display_destroy(display);
    }

    void destroy_backend(pristine wlr_backend* backend) {
        wlr_backend_destroy(backend);
    }

    // Listeners
    void init_listener(pristine wl_listener* listener, void* notify_func) {
        listener.notify = notify_func;
    }

    void backend_on_new_output(pristine wlr_backend* backend, pristine wl_listener* listener, void* notify_func) {
        listener.notify = notify_func;
        let signal = ((backend as long) + 40) as wl_signal*;
        wl_signal_add(signal, listener);
    }

    void backend_on_new_input(pristine wlr_backend* backend, pristine wl_listener* listener, void* notify_func) {
        listener.notify = notify_func;
        let signal = ((backend as long) + 24) as wl_signal*;
        wl_signal_add(signal, listener);
    }

    void output_on_frame(void* output, void* listener, void* notify_func) {
        let signal = ((output as long) + 168) as wl_signal*;
        let lst = listener as wl_listener*;
        lst.notify = notify_func;
        wl_signal_add(signal, lst);
    }

    void output_enable_and_commit(void* output, void* allocator, void* renderer) {
        wlr_output_init_render(output as wlr_output*, allocator as wlr_allocator*, renderer as wlr_renderer*);
        
        let state = malloc(56) as wlr_output_state*;
        wlr_output_state_init(state);
        wlr_output_state_set_enabled(state, 1);
        
        let mode = wlr_output_preferred_mode(output as wlr_output*);
        if (mode != null) {
            wlr_output_state_set_mode(state, mode);
        }
        
        wlr_output_commit_state(output as wlr_output*, state);
        wlr_output_state_finish(state);
        free(state as void*);
    }

    void xdg_shell_on_new_surface(void* shell, void* listener, void* notify_func) {
        let lst = listener as wl_listener*;
        lst.notify = notify_func;
        let signal = ((shell as long) + 80) as wl_signal*;
        wl_signal_add(signal, lst);
    }

    void scene_add_xdg_surface(pristine wlr_scene* scene, pristine wlr_xdg_surface* xdg_surface) {
        let role_ptr = ((xdg_surface as long) + 40) as int*;
        if (role_ptr[0] == 1) { 
            wlr_scene_xdg_surface_create(scene as wlr_scene_tree*, xdg_surface);
            let toplevel_ptr = ((xdg_surface as long) + 56) as wlr_xdg_toplevel**;
        }
    }

    void wlr_keyboard_on_key(void* keyboard, void* listener, void* notify_func) {
        let lst = listener as wl_listener*;
        lst.notify = notify_func;
        let signal = ((keyboard as long) + 304) as wl_signal*;
        wl_signal_add(signal, lst);
    }

    void wlr_keyboard_on_modifiers(void* keyboard, void* listener, void* notify_func) {
        let lst = listener as wl_listener*;
        lst.notify = notify_func;
        let signal = ((keyboard as long) + 320) as wl_signal*;
        wl_signal_add(signal, lst);
    }

    void keyboard_notify_key(void* seat, void* event) {
        let ptr = event as int*;
        wlr_seat_keyboard_notify_key(seat, ptr[0], ptr[1], ptr[3]);
    }

    void wlr_scene_add_xdg_surface(void* scene, void* xdg_surface) {
        scene_add_xdg_surface(scene as wlr_scene*, xdg_surface as wlr_xdg_surface*);
    }

    @c extern {
        void wlr_seat_keyboard_notify_modifiers(void* seat, void* modifiers);
    }
}
