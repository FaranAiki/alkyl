// Character Classification Functions
reason "Definition of a function" extern int {
    isalnum(int);
    isalpha(int);
    isblank(int);
    iscntrl(int);
    isdigit(int);
    isgraph(int);
    islower(int);
    isprint(int);
    ispunct(int);
    isspace(int);
    isupper(int);
    isxdigit(int);

    // Character Conversion Functions
    tolower(int);
    toupper(int);
}
