import "lib/c";
struct Event {
    int time_msec;
    int keycode;
}
int main() {
    let event = clib.malloc(8) as Event*;
    event.keycode = 28;
    if (event.keycode == 16) {
        clib.printf("BUG: Q pressed!\n");
    }
    if (event.keycode == 20) {
        clib.printf("BUG: T pressed!\n");
    }
    clib.printf("Done.\n");
    return 0;
}
