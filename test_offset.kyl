import "lib/c"
meta {
    c_compiler.include_dir = "/usr/include/wlroots-0.18"
    c_compiler.include_dir = "/usr/include/libdrm"
}
@c import "wayland-server-core.h"
@c import "wlr/types/wlr_keyboard.h"

int main() {
    wlr_keyboard* kb = null as wlr_keyboard*;
    wl_signal* sig = &(kb.events.key);
    printf("Alkyl offset: %p\n", sig);
    return 0;
}
