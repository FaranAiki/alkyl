import "std/print";

class Vector {
    private:
        int x = 0;
        int y = 0;
    public:
        void set(int x, int y) {
            this.x = x;
            this.y = y;
        }
        int[2] get() {
            return [this.x, this.y];
        }
}

int main() {
    let vec1 = Vector(1, 2);
    print "vec1 ", vec1.get()[0], " ", vec1.get()[1], "\n";
    return 0;
}
