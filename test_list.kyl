import "lib/c";

struct wl_list {
    wl_list* prev;
    wl_list* next;
}

struct wl_signal {
    wl_list listener_list;
}

struct wl_listener {
    wl_list link;
    void* notify;
}

void wl_list_insert(wl_list* list, wl_list* elm) {
    elm.prev = list;
    elm.next = list.next;
    list.next = elm;
    elm.next.prev = elm;
}

void wl_signal_add(wl_signal* signal, wl_listener* listener) {
    wl_list_insert(signal.listener_list.prev, &(listener.link));
}

int main() {
    wl_signal sig;
    sig.listener_list.prev = &(sig.listener_list);
    sig.listener_list.next = &(sig.listener_list);

    wl_listener lst;
    wl_signal_add(&sig, &lst);

    printf("Success!\n");
    return 0;
}
