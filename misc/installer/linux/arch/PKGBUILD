pkgname=alkyl
pkgver=0.1.0
pkgrel=1
pkgdesc="Alkyl Programming Language Compiler"
arch=('x86_64')
url="https://github.com/FaranAiki/alkyl"
license=('MIT')
depends=('gcc-libs' 'glibc' 'llvm-libs' 'zlib' 'ncurses' 'readline' 'libffi')
makedepends=('cmake' 'llvm' 'git')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$pkgname"
  mkdir -p build
  cd build
  cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILDALL=OFF \
    -DBACKEND=llvm
  cmake --build .
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 build/alkyl_llvm "$pkgdir/usr/bin/alkyl"
  install -Dm755 build/ethyl "$pkgdir/usr/bin/ethyl"

  install -Dm644 misc/asset/logo.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/alkyl.png"

  install -Dm644 misc/installer/linux/arch/alkyl.desktop "$pkgdir/usr/share/applications/alkyl.desktop"

  install -Dm644 misc/installer/linux/arch/application-x-alkyl.xml "$pkgdir/usr/share/mime/packages/application-x-alkyl.xml"

  install -Dm644 misc/asset/script_logo.png "$pkgdir/usr/share/icons/hicolor/512x512/mimetypes/application-x-alkyl.png"
}
