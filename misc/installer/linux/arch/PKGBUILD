pkgname=alkyl
pkgver=0.1.0
pkgrel=1
pkgdesc="Alkyl Programming Language Compiler"
arch=('x86_64')
url="https://github.com/FaranAiki/alkyl"
license=('MIT')
depends=('gcc-libs' 'glibc' 'llvm-libs' 'zlib' 'ncurses' 'readline' 'libffi')
makedepends=('cmake' 'llvm' 'git')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$pkgname"
  mkdir -p build
  cd build
  cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILDALL=OFF \
    -DBACKEND=llvm
  cmake --build .
}

package() {
  cd "$srcdir/$pkgname/build"

  install -Dm755 alkyl_llvm "$pkgdir/usr/bin/alkyl"
  install -Dm755 ethyl "$pkgdir/usr/bin/ethyl"

  install -Dm644 ../misc/asset/logo.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/alkyl.png"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/alkyl.desktop" <<EOF
[Desktop Entry]
Name=Alkyl Compiler
Exec=alkyl %F
Icon=alkyl
Terminal=true
Type=Application
Categories=Development;
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/share/mime/packages/application-x-alkyl.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-alkyl">
    <comment>Alkyl Source File</comment>
    <glob pattern="*.kyl"/>
    <glob pattern="*.hky"/>
    <icon name="application-x-alkyl"/>
  </mime-type>
</mime-info>
EOF

  install -Dm644 ../misc/asset/script_logo.png "$pkgdir/usr/share/icons/hicolor/512x512/mimetypes/application-x-alkyl.png"
}
