import "wlroots/core";
import "std/print";

meta {
    reason "Debug offsets"
    lexer.scope_style = SCOPE_BRACKETS;
}

int main() {
    std.printf("Size of wlr_keyboard: %d\n", sizeof(wlroots.wlr_keyboard));
    std.printf("Size of wl_listener: %d\n", sizeof(wlroots.wl_listener));
    
    // Create a dummy wlr_keyboard to get offsets
    wlroots.wlr_keyboard kb;
    long kb_ptr = &kb as long;
    long key_ptr = &(kb.events.key) as long;
    std.printf("Offset of events.key: %ld\n", key_ptr - kb_ptr);
    
    return 0;
}
