/*
    wlroots wayland window manager
*/
premeta {
    reason "Standard block style for C-like code"
    lexer.scope_style = SCOPE_BRACKETS;
}

import "std/print";
import "../../lib/std/heap";

link "wayland-server";
link "wlroots-0.18";

@c import "wlr/backend.h"
@c import "wlr/render/allocator.h"
@c import "wlr/render/wlr_renderer.h"
@c import "wlr/types/wlr_output.h"
@c import "wlr/types/wlr_xdg_shell.h"
@c import "wlr/types/wlr_scene.h"
@c import "wlr/types/wlr_seat.h"
@c import "wlr/types/wlr_keyboard.h"
@c import "wlr/types/wlr_compositor.h"
@c import "wlr/types/wlr_data_device.h"
@c import "wlr/types/wlr_pointer.h"
@c import "wayland-server-core.h"

link "wayland-server";
link "wlroots-0.18";

extern int setenv(char* name, char* value, int overwrite);
extern int fork();
extern int execl(char* path, char* arg0, char* arg1, char* arg2, void* arg3);
extern void _exit(int status);

// time.h clock_gettime
extern int clock_gettime(int clk_id, void* tp);
extern void* malloc(long size);
extern void free(void* ptr);

export namespace wlroots {



    extern void wlr_seat_keyboard_notify_key(void* seat, int time_msec, int keycode, int state);
    extern void wlr_seat_keyboard_notify_enter(void* seat, void* surface, int keycodes, long num_keycodes, void* modifiers);




    class Display {
        wl_display* handle;
        errnum [ErrDisplayCreation] void? init() {
            let display = wl_display_create();
            if (display == null ? true) {
                purge ErrDisplayCreation;
            }
            this.handle = display as wl_display*;
        }
        errnum [ErrSocketCreation] char*? add_socket_auto() {
            let socket = wl_display_add_socket_auto(this.handle);
            if (socket == null ? true) {
                purge ErrSocketCreation;
            }
            return socket;
        }
        void run() {
            wl_display_run(this.handle);
        }
        void terminate() {
            wl_display_terminate(this.handle);
        }
        void destroy_clients() {
            wl_display_destroy_clients(this.handle);
        }
        void destroy() {
            wl_display_destroy(this.handle);
        }
    }

    class Backend {
        wlr_backend* handle;
        errnum [ErrBackendCreation] void? init(Display* display) {
            let event_loop = wl_display_get_event_loop(display.handle);
            let backend = wlr_backend_autocreate(event_loop, null as wlr_backend**);
            if (backend == null ? true) {
                purge ErrBackendCreation;
            }
            this.handle = backend as wlr_backend*;
        }
        errnum [ErrBackendStart] bool? start() {
            if (wlr_backend_start(this.handle) == false) {
                purge ErrBackendStart;
            }
            return true;
        }
        void destroy() {
            wlr_backend_destroy(this.handle);
        }
    }

    class Renderer {
        wlr_renderer* handle;
        errnum [ErrRendererCreation] void? init(Backend* backend) {
            let renderer = wlr_renderer_autocreate(backend.handle);
            if (renderer == null ? true) {
                purge ErrRendererCreation;
            }
            this.handle = renderer as wlr_renderer*;
        }
        void init_display(Display* display) {
            wlr_renderer_init_wl_display(this.handle, display.handle);
        }
    }

    class Allocator {
        wlr_allocator* handle;
        errnum [ErrAllocatorCreation] void? init(Backend* backend, Renderer* renderer) {
            let allocator = wlr_allocator_autocreate(backend.handle, renderer.handle);
            if (allocator == null ? true) {
                purge ErrAllocatorCreation;
            }
            this.handle = allocator as wlr_allocator*;
        }
    }

    class Compositor {
        wlr_compositor* handle;
        errnum [ErrCompositorCreation] void? init(Display* display, Renderer* renderer) {
            let compositor = wlr_compositor_create(display.handle, 5, renderer.handle);
            if (compositor == null ? true) {
                purge ErrCompositorCreation;
            }
            this.handle = compositor as wlr_compositor*;
        }
    }

    class DataDeviceManager {
        wlr_data_device_manager* handle;
        errnum [ErrDataDeviceManagerCreation] void? init(Display* display) {
            let tainted manager = wlr_data_device_manager_create(display.handle);
            if (manager == null ? true) {
                purge ErrDataDeviceManagerCreation;
            }
            this.handle = manager as wlr_data_device_manager*;
        }
    }

    class Subcompositor {
        wlr_subcompositor* handle;
        errnum [ErrSubcompositorCreation] void? init(Display* display) {
            let tainted subcompositor = wlr_subcompositor_create(display.handle);
            if (subcompositor == null ? true) {
                purge ErrSubcompositorCreation;
            }
            this.handle = subcompositor as wlr_subcompositor*;
        }
    }

    class OutputLayout {
        wlr_output_layout* handle;
        errnum [ErrOutputLayoutCreation] void? init(Display* display) {
            let layout = wlr_output_layout_create(display.handle);
            if (layout == null ? true) {
                purge ErrOutputLayoutCreation;
            }
            this.handle = layout as wlr_output_layout*;
        }
    }

    class Scene {
        wlr_scene* handle;
        void init() {
            this.handle = wlr_scene_create();
        }
        void attach_output_layout(OutputLayout* layout) {
            wlr_scene_attach_output_layout(this.handle, layout.handle);
        }
    }

    class XdgShell {
        wlr_xdg_shell* handle;
        errnum [ErrXdgShellCreation] void? init(Display* display, int version) {
            let shell = wlr_xdg_shell_create(display.handle, version);
            if (shell == null ? true) {
                purge ErrXdgShellCreation;
            }
            this.handle = shell as wlr_xdg_shell*;
        }
    }

    class Seat {
        wlr_seat* handle;
        errnum [ErrSeatCreation] void? init(Display* display, char* name) {
            let seat = wlr_seat_create(display.handle, name);
            if (seat == null ? true) {
                purge ErrSeatCreation;
            }
            this.handle = seat as wlr_seat*;
        }
        void set_keyboard(void* keyboard) {
            wlr_seat_set_keyboard(this.handle, keyboard);
        }
        void set_capabilities(int caps) {
            wlr_seat_set_capabilities(this.handle, caps);
        }
        void focus_xdg_surface(wlroots.wlr_xdg_surface* xdg_surface) {
            // TODO do not hardcode this
            int *role_ptr = ((xdg_surface as long) + 40) as int*;
            if (*role_ptr == 1) { // WLR_XDG_SURFACE_ROLE_TOPLEVEL
                // TODO do not hardcode this
                let surface_ptr = ((xdg_surface as long) + 16);
                let surface = (surface_ptr as void*);
                wlr_seat_keyboard_notify_enter(this.handle, surface, 0, 0, null);
            }
        }
        void keyboard_notify_key(int time_msec, int keycode, int state) {
            wlr_seat_keyboard_notify_key(this.handle, time_msec, keycode, state);
        }
    }

    void backend_on_new_output(Backend* backend, wlroots.wl_listener* listener, void* notify_func) {
        listener.notify = notify_func;
        let signal = &backend.handle.events.new_output;
        wlroots.wl_signal_add(signal, listener);
    }

    void backend_on_new_input(Backend* backend, wlroots.wl_listener* listener, void* notify_func) {
        listener.notify = notify_func;
        let signal = &backend.handle.events.new_input;
        wlroots.wl_signal_add(signal, listener);
    }

    void xdg_shell_on_new_surface(XdgShell* shell, wlroots.wl_listener* listener, void* notify_func) {
        listener.notify = notify_func;
        let signal = &(shell.handle.events.new_surface);
        wlroots.wl_signal_add(signal, listener);
    }

    void scene_add_xdg_surface(Scene* scene, wlroots.wlr_xdg_surface* xdg_surface) {
        let role_ptr = &(xdg_surface.role);
        if (*role_ptr == 1) {
            wlr_scene_xdg_surface_create(scene.handle as wlr_scene_tree*, xdg_surface);
        }
    }

    void output_enable_and_commit(wlroots.wlr_output* output, Allocator* allocator, Renderer* renderer) {
        wlr_output_init_render(output, allocator.handle, renderer.handle);

        let state = malloc(128) as wlr_output_state*;
        wlr_output_state_init(state);
        wlr_output_state_set_enabled(state, 1);

        let mode = wlr_output_preferred_mode(output);
        if (mode != null) {
            wlr_output_state_set_mode(state, mode);
        }

        wlr_output_commit_state(output, state);
        wlr_output_state_finish(state);
        free(state);
    }

    void output_on_frame(void* output, wlroots.wl_listener* listener, void* notify_func) {
        listener.notify = notify_func;
        let signal = &(output.events.frame);
        wlroots.wl_signal_add(signal, listener);
    }

    void keyboard_on_key(void* keyboard, wlroots.wl_listener* listener, void* notify_func) {
        listener.notify = notify_func;
        let signal = &(keyboard.events.key);
        wlroots.wl_signal_add(signal, listener);
    }
}

class Server {
    wlroots.Display* display;
    wlroots.Backend* backend;
    wlroots.Renderer* renderer;
    wlroots.Allocator* allocator;
    wlroots.Compositor* compositor;
    wlroots.OutputLayout* output_layout;
    wlroots.Scene* scene;
    wlroots.XdgShell* xdg_shell;
    wlroots.Seat* seat;

    void* manager;
    void* subcompositor;

    wlroots.wl_listener* new_output;
    wlroots.wl_listener* new_input;
    wlroots.wl_listener* new_xdg_surface;
}

class Output {
    Server* server;
    wlroots.wlr_output* wlr_output_handle;
    wlroots.wlr_scene_output* scene_output;
    wlroots.wl_listener* frame_event;
}

class Keyboard {
    Server* server;
    void* wlr_keyboard_handle;
    wlroots.wl_listener* key;
}

struct KeyboardKeyEvent {
    int time_msec;
    int keycode;
    int update_state;
    int state;
}

void keyboard_handle_key(void* listener_ptr, void* data) {
    let listener = listener_ptr as wlroots.wl_listener*;
    let kb = listener.data as Keyboard*;
    let server = kb.server;

    let event = data as KeyboardKeyEvent*;
    let keycode = event.keycode;
    let state = event.state;

    // KEY_ESC is 1, state 1 is PRESSED
    if (state == 1) {
        std.printf("Key pressed: {}\n", keycode);
    }
    if (keycode == 1) {
        if (state == 1) { // Quick hack to allow exiting even without modifier pointer!
            printf("ESC pressed, exiting gracefully...\n");
            server.display.terminate();
        }
    }

    // KEY_T is 20, state 1 is PRESSED (spawn kitty on Super+T)
    if (keycode == 20) {
        if (state == 1) { // Hack without modifier
            printf("T pressed, spawning kitty...\n");
            let pid = fork();
            if (pid == 0) {
                execl("/usr/bin/kitty", "kitty", null, null, null);
                _exit(1);
            }
        }
    }

    server.seat.keyboard_notify_key(event.time_msec, event.keycode, event.state);
}

void server_new_input(void* listener_ptr, void* data) {
    let listener = listener_ptr as wlroots.wl_listener*;
    let server = listener.data as Server*;
    let device = data;
    let device_type = *(device as int*);

    if (device_type == 0) { // WLR_INPUT_DEVICE_KEYBOARD
        printf("New input detected! Treating as keyboard...\n");
        let keyboard = wlroots.wlr_keyboard_from_input_device(device);
        server.seat.set_keyboard(keyboard);
        server.seat.set_capabilities(1); // WL_SEAT_CAPABILITY_KEYBOARD

        let kb = malloc(24) as Keyboard*;
        kb.server = server;
        kb.wlr_keyboard_handle = keyboard;

        // use Allocator instead of malloc and free
        let key_listener = malloc(32) as wlroots.wl_listener*;
        key_listener.data = kb;
        kb.key = key_listener;
        wlroots.keyboard_on_key(keyboard, key_listener, keyboard_handle_key);
    } else {
        printf("New input detected, but it is not a keyboard (type {}). Ignoring.\n", device_type);
    }
}

void output_frame(void* listener_ptr, void* data) {
    let listener = listener_ptr as wlroots.wl_listener*;
    let output = listener.data as Output*;

    wlroots.wlr_scene_output_commit(output.scene_output, null);

    let timespec = malloc(16);
    clock_gettime(1, timespec); // 1 = CLOCK_MONOTONIC
    wlroots.wlr_scene_output_send_frame_done(output.scene_output, timespec);
    free(timespec);
}

void server_new_output(void* listener_ptr, void* data) {
    let listener = listener_ptr as wlroots.wl_listener*;
    let server = listener.data as Server*;
    let wlr_output_handle = data as wlroots.wlr_output*;

    printf("New output connected!\n");
    wlroots.output_enable_and_commit(wlr_output_handle, server.allocator, server.renderer);

    wlroots.wlr_output_layout_add_auto(server.output_layout.handle, wlr_output_handle);

    let scene_output = wlroots.wlr_scene_output_create(server.scene.handle, wlr_output_handle);

    let output = malloc(32) as Output*;
    output.server = server;
    output.wlr_output_handle = wlr_output_handle;
    output.scene_output = scene_output;

    // Use Allocator instead of malloc!
    let frame_listener = malloc(32) as wlroots.wl_listener*;
    frame_listener.data = output;
    output.frame_event = frame_listener;

    wlroots.output_on_frame(wlr_output_handle, frame_listener, output_frame);

    wlroots.wlr_scene_output_commit(scene_output, null); // Kick off the first frame
}

void server_new_xdg_surface(void* listener_ptr, void* data) {
    let listener = listener_ptr as wlroots.wl_listener*;
    let server = listener.data as Server*;
    let xdg_surface = data as wlroots.wlr_xdg_surface*;

    printf("New XDG Surface requested!\n");
    wlroots.scene_add_xdg_surface(server.scene, xdg_surface);
    server.seat.focus_xdg_surface(xdg_surface);
}

int main() {
    printf("Starting wmyl (wlroots minimal WM)...\n");

    let ac = ArenaAllocator();
    ac.head = null;
    ac.default_block_size = 65536;

    let server = ac.alloc[Server]();
    untaint server residue err { return 1; }

    let new_input = ac.alloc[wlroots.wl_listener]();
    untaint new_input residue err { return 1; }
    new_input._link.prev = null;
    new_input._link.next = null;
    new_input.notify = null;
    new_input.data = server;
    server.new_input = new_input;

    let new_output = ac.alloc[wlroots.wl_listener]();
    untaint new_output residue err { return 1; }
    new_output.data = server;
    server.new_output = new_output;

    let new_xdg_surface = ac.alloc[wlroots.wl_listener]();
    untaint new_xdg_surface residue err { return 1; }
    new_xdg_surface.data = server;
    server.new_xdg_surface = new_xdg_surface;

    let display = ac.alloc[wlroots.Display]();
    untaint display residue err { return 1; }
    let _init_disp = display.init();
    untaint _init_disp residue err { return 1; }
    server.display = display;

    printf("Running Wayland display...\n");

    let backend = ac.alloc[wlroots.Backend]();
    untaint backend residue err { return 1; }
    let _init_backend = backend.init(server.display);
    untaint _init_backend residue err { return 1; }
    server.backend = backend;

    let renderer = ac.alloc[wlroots.Renderer]();
    untaint renderer residue err { return 1; }
    let _init_renderer = renderer.init(server.backend);
    untaint _init_renderer residue err { return 1; }
    server.renderer = renderer;
    server.renderer.init_display(server.display);

    let allocator = ac.alloc[wlroots.Allocator]();
    untaint allocator residue err { return 1; }
    let _init_alloc = allocator.init(server.backend, server.renderer);
    untaint _init_alloc residue err { return 1; }
    server.allocator = allocator;

    let compositor = ac.alloc[wlroots.Compositor]();
    untaint compositor residue err { return 1; }
    let _init_comp = compositor.init(server.display, server.renderer);
    untaint _init_comp residue err { return 1; }
    server.compositor = compositor;

    let manager = ac.alloc[wlroots.DataDeviceManager]();
    untaint manager residue err { return 1; }
    let _init_mgr = manager.init(server.display);
    untaint _init_mgr residue err { return 1; }
    server.manager = manager;

    let subcompositor = ac.alloc[wlroots.Subcompositor]();
    untaint subcompositor residue err { return 1; }
    let _init_sub = subcompositor.init(server.display);
    untaint _init_sub residue err { return 1; }
    server.subcompositor = subcompositor;

    let output_layout = ac.alloc[wlroots.OutputLayout]();
    untaint output_layout residue err { return 1; }
    let _init_layout = output_layout.init(server.display);
    untaint _init_layout residue err { return 1; }
    server.output_layout = output_layout;

    let scene = ac.alloc[wlroots.Scene]();
    untaint scene residue err { return 1; }
    scene.init();
    server.scene = scene;
    server.scene.attach_output_layout(server.output_layout);

    let xdg_shell = ac.alloc[wlroots.XdgShell]();
    untaint xdg_shell residue err { return 1; }
    let _init_shell = xdg_shell.init(server.display, 6);
    untaint _init_shell residue err { return 1; }
    server.xdg_shell = xdg_shell;

    let seat = ac.alloc[wlroots.Seat]();
    untaint seat residue err { return 1; }
    let _init_seat = seat.init(server.display, "seat0");
    untaint _init_seat residue err { return 1; }
    server.seat = seat;

    wlroots.backend_on_new_output(server.backend, server.new_output, server_new_output);
    wlroots.backend_on_new_input(server.backend, server.new_input, server_new_input);
    wlroots.xdg_shell_on_new_surface(server.xdg_shell, server.new_xdg_surface, server_new_xdg_surface);

    let socket = server.display.add_socket_auto();
    untaint socket residue err { return 1; }

    printf("Listening Wayland display on {}...\n", socket);

    let started = server.backend.start();
    untaint started residue err { return 1; }

    printf("Backend started successfully! Spawning kitty...\n");

    setenv("WAYLAND_DISPLAY", socket, 1);
    let pid = fork();
    if (pid == 0) {
        execl("/usr/bin/kitty", "kitty", null, null, null);
        _exit(1);
    }
    server.display.terminate();

    server.display.run();
    server.display.destroy_clients();
    server.display.destroy();

    printf("wmyl exited gracefully.\n");
    return 0;
}
