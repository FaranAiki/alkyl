import "std/print";
import "wlroots/core";

// Alkyl doesn't support hyphens in link identifier
// do this
link "wayland-server";
link "wlroots-0.18";

int main() {
    std.printf("Starting wmyl (wlroots minimal WM)...\n");

    // 1. Initialize Wayland display
    let display = wlroots.create_display();
    untaint display residue err {
        std.printf("Failed to create Wayland display\n");
        return 1;
    }

    std.printf("Starting backend...\n");

    // 2. Create the backend
    let backend = wlroots.create_backend(display);
    untaint backend residue err {
        std.printf("Failed to create wlroots backend\n");
        wlroots.destroy_display(display);
        return 1;
    }

    // 3. Create renderer
    let renderer = wlroots.create_renderer(backend);
    untaint renderer residue err {
        std.printf("Failed to create wlroots renderer\n");
        wlroots.destroy_backend(backend);
        wlroots.destroy_display(display);
        return 1;
    }
    
    wlroots.init_renderer(renderer, display);

    // 4. Create allocator
    let allocator = wlroots.create_allocator(backend, renderer);
    untaint allocator residue err {
        std.printf("Failed to create wlroots allocator\n");
        wlroots.destroy_backend(backend);
        wlroots.destroy_display(display);
        return 1;
    }

    // 5. Create compositor and output layout
    let compositor = wlroots.create_compositor(display, renderer);
    untaint compositor residue err { return 1; }
    
    let manager = wlroots.create_data_device_manager(display);
    untaint manager residue err { return 1; }

    let output_layout = wlroots.create_output_layout(display);
    untaint output_layout residue err { return 1; }

    // 6. Start backend
    let started = wlroots.start_backend(backend);
    untaint started residue err {
        std.printf("Failed to start wlroots backend\n");
        wlroots.destroy_backend(backend);
        wlroots.destroy_display(display);
        return 1;
    }

    std.printf("Backend started successfully! Running Wayland display...\n");

    // 7. Run event loop
    wlroots.run_display(display);

    // 8. Cleanup
    wlroots.destroy_clients(display);
    wlroots.destroy_display(display);

    std.printf("wmyl exited gracefully.\n");
    return 0;
}
