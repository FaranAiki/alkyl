#!/bin/bash
set -euo pipefail

# Alkyl Build Comparison Script
# Usage: ./scripts/compare_bin <filename> [--opt|--unopt] [--runs N] [-- <extra compiler flags>]

COMPILERS=("build/alkyl_llvm" "build/alkyl_qbe" "build/alkyl_mlir" "build/alkyl_cranelift")
BACKENDS=("llvm" "qbe" "mlir" "cranelift")
RUNS=100
MODE="opt"
EXTRA_FLAGS=()

# Color output
COLOR_RESET="\033[0m"
COLOR_RED="\033[1;31m"
COLOR_GREEN="\033[1;32m"
COLOR_YELLOW="\033[1;33m"
COLOR_CYAN="\033[1;36m"
COLOR_BOLD="\033[1m"

# Parse args
FILENAME=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --opt) MODE="opt"; shift ;;
        --unopt) MODE="unopt"; shift ;;
        --runs) RUNS="$2"; shift 2 ;;
        --) shift; EXTRA_FLAGS=("$@"); break ;;
        -*) echo -e "${COLOR_RED}Error: Unknown option: $1${COLOR_RESET}" >&2; exit 1 ;;
        *) FILENAME="$1"; shift ;;
    esac
done

if [[ -z "$FILENAME" ]]; then
    echo -e "${COLOR_BOLD}Usage:${COLOR_RESET} $0 <filename> [--opt|--unopt] [--runs N] [-- <extra flags>]"
    exit 1
fi

if [[ -f "$FILENAME" ]]; then
    KYL_FILE="$FILENAME"
elif [[ "$FILENAME" == *.kyl ]]; then
    KYL_FILE="test/code/examples/$FILENAME"
    if [[ ! -f "$KYL_FILE" ]]; then echo -e "${COLOR_RED}Error: File '$FILENAME' not found${COLOR_RESET}" >&2; exit 1; fi
else
    KYL_FILE="test/code/examples/$FILENAME.kyl"
    if [[ ! -f "$KYL_FILE" ]]; then echo -e "${COLOR_RED}Error: test/code/examples/$FILENAME.kyl not found${COLOR_RESET}" >&2; exit 1; fi
fi

echo -e "${COLOR_BOLD}========================================${COLOR_RESET}"
echo -e "${COLOR_BOLD} Alkyl Build Comparison (Extended)${COLOR_RESET}"
echo -e "${COLOR_BOLD}========================================${COLOR_RESET}"
echo -e "Source:   ${COLOR_CYAN}$KYL_FILE${COLOR_RESET}"
echo -e "Mode:     ${COLOR_CYAN}--$MODE${COLOR_RESET}"
echo -e "Runs:     ${COLOR_CYAN}$RUNS${COLOR_RESET}"
echo ""

if [[ "$MODE" == "opt" ]]; then
    COMPILER_FLAG="-O3"
else
    COMPILER_FLAG="--unopt"
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

declare -a compile_times=()
declare -a exec_times=()
declare -a sizes=()
declare -a stripped_sizes=()
declare -a compile_mem=()
declare -a exec_mem=()
declare -a cache_misses=()
declare -a compile_status=()

for i in "${!BACKENDS[@]}"; do
    backend="${BACKENDS[$i]}"
    compiler="${COMPILERS[$i]}"
    out_bin="$TMPDIR/${backend}_${MODE}"
    rm -f "$out_bin"
    echo -e "--- ${COLOR_YELLOW}$backend${COLOR_RESET} ($compiler) ---"

    if [[ ! -x "$compiler" ]]; then
        echo -e "  ${COLOR_RED}Compiler not found${COLOR_RESET}"
        continue
    fi

    HYPERFINE_ARGS=( --warmup 1 --runs "$RUNS" --export-json "$TMPDIR/${backend}_compile.json" --command-name "${backend}-compile" )
    COMPILE_CMD=("$compiler" -o "$out_bin" "$COMPILER_FLAG")
    if [[ ${#EXTRA_FLAGS[@]} -gt 0 ]]; then COMPILE_CMD+=("${EXTRA_FLAGS[@]}"); fi
    COMPILE_CMD+=("$KYL_FILE")

    if hyperfine "${HYPERFINE_ARGS[@]}" "${COMPILE_CMD[*]}"; then
        compile_status[$i]="OK"
    else
        compile_status[$i]="FAIL"
    fi

    if [[ -f "$out_bin" ]]; then
        compile_mean=$(python3 -c "import json; print(f\"{json.load(open('$TMPDIR/${backend}_compile.json'))['results'][0]['mean']:.4f}\")" 2>/dev/null || echo "N/A")
        compile_times[$i]="$compile_mean"

        size=$(stat -c%s "$out_bin" 2>/dev/null || echo "N/A")
        sizes[$i]="$size"

        cp "$out_bin" "$out_bin.stripped"
        strip "$out_bin.stripped" 2>/dev/null || true
        ssize=$(stat -c%s "$out_bin.stripped" 2>/dev/null || echo "N/A")
        stripped_sizes[$i]="$ssize"

        /usr/bin/time -v "${COMPILE_CMD[@]}" 2> "$TMPDIR/${backend}_cmem.txt" || true
        mem=$(grep "Maximum resident set size" "$TMPDIR/${backend}_cmem.txt" | awk '{print $6}' || echo "N/A")
        compile_mem[$i]="$mem"
    else
        compile_times[$i]="N/A"
        sizes[$i]="N/A"
        stripped_sizes[$i]="N/A"
        compile_mem[$i]="N/A"
    fi
done

echo ""
echo -e "${COLOR_BOLD}========================================${COLOR_RESET}"
echo -e "${COLOR_BOLD} Execution, Memory & Cache Analysis${COLOR_RESET}"
echo -e "${COLOR_BOLD}========================================${COLOR_RESET}"

for i in "${!BACKENDS[@]}"; do
    backend="${BACKENDS[$i]}"
    out_bin="$TMPDIR/${backend}_${MODE}"
    if [[ ! -f "$out_bin" ]]; then continue; fi
    echo -e "--- ${COLOR_YELLOW}$backend${COLOR_RESET} ---"

    hyperfine --warmup 1 --runs "$RUNS" --export-json "$TMPDIR/${backend}_exec.json" --command-name "${backend}-exec" "$out_bin" || true
    exec_mean=$(python3 -c "import json; print(f\"{json.load(open('$TMPDIR/${backend}_exec.json'))['results'][0]['mean']:.4f}\")" 2>/dev/null || echo "N/A")
    exec_times[$i]="$exec_mean"

    /usr/bin/time -v "$out_bin" >/dev/null 2> "$TMPDIR/${backend}_emem.txt" || true
    emem=$(grep "Maximum resident set size" "$TMPDIR/${backend}_emem.txt" | awk '{print $6}' || echo "N/A")
    exec_mem[$i]="$emem"

    if command -v valgrind &>/dev/null; then
        valgrind --tool=cachegrind --cachegrind-out-file="$TMPDIR/${backend}_cg.out" "$out_bin" >/dev/null 2> "$TMPDIR/${backend}_cg.txt" || true
        d1=$(grep "D1  misses:" "$TMPDIR/${backend}_cg.txt" | awk '{print $3}' | tr -d ',' || echo "N/A")
        ll=$(grep "LL misses:" "$TMPDIR/${backend}_cg.txt" | awk '{print $3}' | tr -d ',' || echo "N/A")
        cache_misses[$i]="${d1}/${ll}"
    else
        cache_misses[$i]="No Valgrind"
    fi
done

echo ""
echo -e "${COLOR_BOLD}========================================${COLOR_RESET}"
echo -e "${COLOR_BOLD} Summary${COLOR_RESET}"
echo -e "${COLOR_BOLD}========================================${COLOR_RESET}"
printf "%-10s | %-6s | %-11s | %-11s | %-11s | %-11s | %-10s | %-10s | %-14s\n" "Backend" "Status" "Compile (s)" "Exec (s)" "Comp Mem(K)" "Exec Mem(K)" "Size (B)" "Strip (B)" "Cache D1/LL"
printf "%-10s-+-%-6s-+-%-11s-+-%-11s-+-%-11s-+-%-11s-+-%-10s-+-%-10s-+-%-14s\n" "----------" "------" "-----------" "-----------" "-----------" "-----------" "----------" "----------" "--------------"

for i in "${!BACKENDS[@]}"; do
    backend="${BACKENDS[$i]}"
    status="${compile_status[$i]:-N/A}"
    compile="${compile_times[$i]:-N/A}"
    exec="${exec_times[$i]:-N/A}"
    cmem="${compile_mem[$i]:-N/A}"
    emem="${exec_mem[$i]:-N/A}"
    size="${sizes[$i]:-N/A}"
    ssize="${stripped_sizes[$i]:-N/A}"
    cache="${cache_misses[$i]:-N/A}"
    printf "%-10s | %-6s | %-11s | %-11s | %-11s | %-11s | %-10s | %-10s | %-14s\n" "$backend" "$status" "$compile" "$exec" "$cmem" "$emem" "$size" "$ssize" "$cache"
done

echo ""
echo -e "${COLOR_BOLD}Winners & Losers:${COLOR_RESET}"

# Fastest compile
fastest_compile=""
fastest_compile_time="999999"
slowest_compile=""
slowest_compile_time="-1"
for i in "${!BACKENDS[@]}"; do
    if [[ "${compile_times[$i]:-N/A}" != "N/A" ]]; then
        if python3 -c "import sys; print(float() < float())" 2>/dev/null | grep -q True; then
            fastest_compile_time="${compile_times[$i]}"
            fastest_compile="${BACKENDS[$i]}"
        fi
        if python3 -c "import sys; print(float() > float())" 2>/dev/null | grep -q True; then
            slowest_compile_time="${compile_times[$i]}"
            slowest_compile="${BACKENDS[$i]}"
        fi
    fi
done
[[ -n "$fastest_compile" ]] && echo -e "  Fastest compile: ${COLOR_GREEN}$fastest_compile${COLOR_RESET} (${fastest_compile_time}s)"
[[ -n "$slowest_compile" ]] && echo -e "  Slowest compile: ${COLOR_RED}$slowest_compile${COLOR_RESET} (${slowest_compile_time}s)"

# Fastest exec
fastest_exec=""
fastest_exec_time="999999"
slowest_exec=""
slowest_exec_time="-1"
for i in "${!BACKENDS[@]}"; do
    if [[ "${exec_times[$i]:-N/A}" != "N/A" ]]; then
        if python3 -c "import sys; print(float() < float())" 2>/dev/null | grep -q True; then
            fastest_exec_time="${exec_times[$i]}"
            fastest_exec="${BACKENDS[$i]}"
        fi
        if python3 -c "import sys; print(float() > float())" 2>/dev/null | grep -q True; then
            slowest_exec_time="${exec_times[$i]}"
            slowest_exec="${BACKENDS[$i]}"
        fi
    fi
done
[[ -n "$fastest_exec" ]] && echo -e "  Fastest exec:    ${COLOR_GREEN}$fastest_exec${COLOR_RESET} (${fastest_exec_time}s)"
[[ -n "$slowest_exec" ]] && echo -e "  Slowest exec:    ${COLOR_RED}$slowest_exec${COLOR_RESET} (${slowest_exec_time}s)"

# Size
smallest=""
smallest_size="999999999"
biggest=""
biggest_size="-1"
for i in "${!BACKENDS[@]}"; do
    if [[ "${sizes[$i]:-N/A}" != "N/A" ]]; then
        if python3 -c "import sys; print(int() < int())" 2>/dev/null | grep -q True; then
            smallest_size="${sizes[$i]}"
            smallest="${BACKENDS[$i]}"
        fi
        if python3 -c "import sys; print(int() > int())" 2>/dev/null | grep -q True; then
            biggest_size="${sizes[$i]}"
            biggest="${BACKENDS[$i]}"
        fi
    fi
done
[[ -n "$smallest" ]] && echo -e "  Smallest size:   ${COLOR_GREEN}$smallest${COLOR_RESET} (${smallest_size} B)"
[[ -n "$biggest" ]]  && echo -e "  Biggest size:    ${COLOR_RED}$biggest${COLOR_RESET} (${biggest_size} B)"
echo ""
