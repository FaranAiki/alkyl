import "lib/c";
struct KeyboardKeyEvent {
    int time_msec;
    int keycode;
    int update_state;
    int state;
}
int main() {
    let event = std.malloc(16) as KeyboardKeyEvent*;
    event.time_msec = 1111;
    event.keycode = 2222;
    event.update_state = 3333;
    event.state = 4444;
    clib.printf("time: %d, keycode: %d, update_state: %d, state: %d\n", event.time_msec, event.keycode, event.update_state, event.state);
    return 0;
}
