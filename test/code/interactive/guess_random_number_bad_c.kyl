import "std/print";
import "std/random";
import "std/input"

// This still suck ass
int main() {
    random.init();
    tainted let inp = 0;
    let total_point = 0;
    while 1 {
        inp = -42;
        print("Guess the number 0 to 10! [current point ", total_point , "]\n");
        let curr_number = random.fast_random() % 10;
        while inp != curr_number {
            print(">> "); scanf("%d", &inp);
            if inp == -1 then return 0;
            if inp == curr_number {
                print("Congrats! Added +1 point\n");
                total_point++;
            } else {
                print ("Pfft! Wrong number, guess again!\n")
            }
        }
    }

    return 0;
}
