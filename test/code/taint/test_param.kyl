import "std/print";

tainted void set(tainted int *t) {
    *t = 2;
    return;
}

errnum[ErrSome]
tainted int set_purged() {
    purge ErrSome;
}

errnum[ErrAny, ErrOtherAny]
tainted int adv_set_purged(int n) {
    if n == 1 then purge ErrAny;
    if n == 2 then purge ErrOtherAny;
    return 6;
}

int main() {
    tainted int t = 1;
    std.print (t ? -1, "\n"); // expect 1

    tainted int p = 1;
    set(&p);
    std.print (p ? -1, "\n"); // expect 2

    tainted int k = set_purged();
    std.print (k ? 3, "\n"); // expect 3

    tainted int z = adv_set_purged(1);
    std.print (z ?[ErrAny] 4 ? -1, "\n"); // expect 4

    tainted int j = adv_set_purged(2);
    std.print (j ?[ErrOtherAny] 5 ? -1, "\n"); // expect 5

    tainted int ks = adv_set_purged(3);
    std.print (ks ? -1, "\n"); // expect 6

    return 0;
}
