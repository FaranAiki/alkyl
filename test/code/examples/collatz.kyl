namespace c { extern int printf(char*, ...) as printf; }

premeta {
    reason "Testing"
    parser.multiplication_if_digit_word = true;
}

void collatz_w_print(int n) {
    c.printf "%d", n;
    while n != 1 {
        c.printf " -> %d", n;
        if n % 2 == 0 then n = n >> 1;
        else n = 3n + 1; // since parser.multiplication_if_digit_word = true
    }
    c.printf "\n";
}

int main() {
    for lt in [1..=100] {
        collatz_w_print(lt);
    }
    return 0;
}
