import "std/heap";
import "std/print";

int main() {
    tainted int* arr = default_allocator.alloc_type[int](10);
    arr[0] = 5;
    arr[1] = 10;

    untaint arr residue err {
        std.print("Allocation failed");
        return 1;
    }
    int x = arr[0];
    int y = arr[1];
    std.print x ? 0, " ", y ? 0, "\n";
    default_allocator.free(arr as void*);
    return 0;
}
