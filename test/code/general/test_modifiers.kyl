abstract class AbstractClass {
    int x;
    int fun();
}

exact class ExactClass {
    int x = 5;
    int fun() { return x; }
}

method class MethodClass {
    int fun() {}
}

container class ContainerClass {
    int x = 5;
    int y;
}

pragma class PragmaClass {
    int x = 5;
    int y;
    int fun() {
      return 1;
    }
    int fun2() {
      return 2;
    }
}

frame class FrameClass {
    int x = 5;
    int y;
    int fun() {}
    int fun2();
}

int main() {
    ExactClass ec;
    if ec.x != 5 then return 5;

    ContainerClass cc = ContainerClass(10, 10);
    if cc.x != cc.y then return 10;
    if cc.x != 10 then return 15;

    return 0;
}
