; ModuleID = 'main_module'
source_filename = "main_module"

%string = type { i32, ptr }

@str.3 = private constant [12 x i8] c"Null error\0A\00"
@str.2 = private constant [13 x i8] c"Div by zero\0A\00"
@str.1 = private constant [7 x i8] c"Clean\0A\00"
@str.0_data = private constant [16 x i8] c"purge: ErrNull\0A\00"
@str.0 = private constant %string { i32 15, ptr @str.0_data }

declare i32 @printf(ptr %0, ...)

define { i32, i32 } @main_m() {
entry:
  ret { i32, i32 } { i32 1, i32 undef }
}

define i32 @main() {
entry:
  %call = call { i32, i32 } @main_m()
  %alloc = alloca { i32, i32 }, align 8
  store { i32, i32 } %call, ptr %alloc, align 4
  %taint_gep = getelementptr inbounds nuw { i32, i32 }, ptr %alloc, i32 0, i32 0
  %load = load i32, ptr %taint_gep, align 4
  %taint_gep1 = getelementptr inbounds nuw { i32, i32 }, ptr %alloc, i32 0, i32 1
  %load2 = load i32, ptr %taint_gep1, align 4
  %eq = icmp eq i32 %load, 0
  br i1 %eq, label %clean_then, label %clean_residue

clean_then:                                       ; preds = %entry
  %call3 = call i32 (ptr, ...) @printf(ptr @str.1)
  br label %clean_merge

clean_residue:                                    ; preds = %entry
  %eq4 = icmp eq i32 %load, 2
  br i1 %eq4, label %case, label %switch_check_1

clean_merge:                                      ; preds = %switch_check_1, %case_2, %case, %clean_then
  ret i32 0

switch_end:                                       ; preds = %switch_end
  br label %switch_end

case:                                             ; preds = %clean_residue
  %call5 = call i32 (ptr, ...) @printf(ptr @str.2)
  br label %clean_merge

case_2:                                           ; preds = %switch_check_1
  %call6 = call i32 (ptr, ...) @printf(ptr @str.3)
  br label %clean_merge

switch_check_1:                                   ; preds = %clean_residue
  %eq7 = icmp eq i32 %load, 1
  br i1 %eq7, label %case_2, label %clean_merge
}
