; ModuleID = 'main_module'
source_filename = "main_module"

@str.10 = private constant [19 x i8] c"anjay aman bosku!\0A\00"
@str.9 = private constant [6 x i8] c"Huh!\0A\00"
@str.8 = private constant [7 x i8] c"Yeay!\0A\00"
@str.7 = private constant [23 x i8] c"Ayam ato ngak daging!\0A\00"
@str.6 = private constant [8 x i8] c"Unknown\00"
@str.5 = private constant [5 x i8] c"Ayam\00"
@str.4 = private constant [7 x i8] c"Burger\00"
@str.3 = private constant [5 x i8] c"Sapi\00"
@str.2 = private constant [7 x i8] c"Daging\00"
@str.1 = private constant [10 x i8] c"%s is %d\0A\00"

declare i32 @printf(ptr %0, ...)

define i32 @main() {
entry:
  %alloc = alloca i32, align 4
  store i32 0, ptr %alloc, align 4
  %alloc1 = alloca ptr, align 8
  store ptr @str.5, ptr %alloc1, align 8
  br label %enum_str_end

enum_str_end:                                     ; preds = %enum_str_case_3, %enum_str_case_2, %enum_str_case, %enum_str_def, %entry
  %load = load ptr, ptr %alloc1, align 8
  %load2 = load i32, ptr %alloc, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.1, ptr %load, i32 %load2)
  %load3 = load i32, ptr %alloc, align 4
  %add = add i32 %load3, 1
  store i32 %add, ptr %alloc, align 4
  %alloc4 = alloca ptr, align 8
  %eq = icmp eq i32 %add, 3
  br i1 %eq, label %enum_str_case_5, label %switch_check_3_2

enum_str_def:                                     ; No predecessors!
  store ptr @str.6, ptr %alloc1, align 8
  br label %enum_str_end

enum_str_case:                                    ; No predecessors!
  store ptr @str.2, ptr %alloc1, align 8
  br label %enum_str_end

enum_str_case_2:                                  ; No predecessors!
  store ptr @str.3, ptr %alloc1, align 8
  br label %enum_str_end

enum_str_case_3:                                  ; No predecessors!
  store ptr @str.4, ptr %alloc1, align 8
  br label %enum_str_end

enum_str_end_2:                                   ; preds = %enum_str_case_8, %enum_str_case_7, %enum_str_case_6, %enum_str_case_5, %enum_str_def_2
  %load5 = load ptr, ptr %alloc4, align 8
  %load6 = load i32, ptr %alloc, align 4
  %call7 = call i32 (ptr, ...) @printf(ptr @str.1, ptr %load5, i32 %load6)
  store i32 3, ptr %alloc, align 4
  %call8 = call i32 (ptr, ...) @printf(ptr @str.7)
  br label %switch_end

enum_str_def_2:                                   ; preds = %switch_check_1_2
  store ptr @str.6, ptr %alloc4, align 8
  br label %enum_str_end_2

enum_str_case_5:                                  ; preds = %enum_str_end
  store ptr @str.2, ptr %alloc4, align 8
  br label %enum_str_end_2

enum_str_case_6:                                  ; preds = %switch_check_3_2
  store ptr @str.3, ptr %alloc4, align 8
  br label %enum_str_end_2

enum_str_case_7:                                  ; preds = %switch_check_2_2
  store ptr @str.4, ptr %alloc4, align 8
  br label %enum_str_end_2

enum_str_case_8:                                  ; preds = %switch_check_1_2
  store ptr @str.5, ptr %alloc4, align 8
  br label %enum_str_end_2

switch_check_3_2:                                 ; preds = %enum_str_end
  %eq9 = icmp eq i32 %add, 2
  br i1 %eq9, label %enum_str_case_6, label %switch_check_2_2

switch_check_2_2:                                 ; preds = %switch_check_3_2
  %eq10 = icmp eq i32 %add, 1
  br i1 %eq10, label %enum_str_case_7, label %switch_check_1_2

switch_check_1_2:                                 ; preds = %switch_check_2_2
  %eq11 = icmp eq i32 %add, 0
  br i1 %eq11, label %enum_str_case_8, label %enum_str_def_2

switch_end:                                       ; preds = %switch_check_2_3, %case_4, %case_3, %enum_str_end_2
  %call12 = call i32 (ptr, ...) @printf(ptr @str.10)
  ret i32 0

case:                                             ; preds = %case
  br label %case

case_3:                                           ; No predecessors!
  %call13 = call i32 (ptr, ...) @printf(ptr @str.8)
  br label %switch_end

case_4:                                           ; No predecessors!
  %call14 = call i32 (ptr, ...) @printf(ptr @str.9)
  br label %switch_end

switch_check_2_3:                                 ; No predecessors!
  br label %switch_end
}
