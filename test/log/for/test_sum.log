; ModuleID = 'main_module'
source_filename = "main_module"

@str.0 = private constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr %0, ...)

define i32 @main() {
entry:
  %alloc = alloca i32, align 4
  store i32 0, ptr %alloc, align 4
  %alloc1 = alloca i32, align 4
  store i32 0, ptr %alloc1, align 4
  br label %for_cond

for_cond:                                         ; preds = %for_body, %entry
  %load = load i32, ptr %alloc1, align 4
  %lt = icmp slt i32 %load, 100
  br i1 %lt, label %for_body, label %for_end

for_body:                                         ; preds = %for_cond
  %load2 = load i32, ptr %alloc1, align 4
  %load3 = load i32, ptr %alloc, align 4
  %add = add i32 %load3, %load2
  store i32 %add, ptr %alloc, align 4
  %load4 = load i32, ptr %alloc1, align 4
  %add5 = add i32 %load4, 1
  store i32 %add5, ptr %alloc1, align 4
  br label %for_cond

for_end:                                          ; preds = %for_cond
  %load6 = load i32, ptr %alloc, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.0, i32 %load6)
  ret i32 0
}
