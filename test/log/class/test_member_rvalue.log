; ModuleID = 'main_module'
source_filename = "main_module"

%Vector = type { i32, i32 }

@str.0 = private constant [3 x i8] c"%d\00"

declare i32 @printf(ptr %0, ...)

define i32 @main() {
entry:
  %alloc = alloca %Vector, align 8
  %struct_gep = getelementptr inbounds nuw %Vector, ptr %alloc, i32 0, i32 0
  store i32 1, ptr %struct_gep, align 4
  %struct_gep1 = getelementptr inbounds nuw %Vector, ptr %alloc, i32 0, i32 1
  store i32 2, ptr %struct_gep1, align 4
  %load = load %Vector, ptr %alloc, align 4
  %alloc2 = alloca %Vector, align 8
  store %Vector %load, ptr %alloc2, align 4
  %struct_gep3 = getelementptr inbounds nuw %Vector, ptr %alloc2, i32 0, i32 0
  %load4 = load i32, ptr %struct_gep3, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.0, i32 %load4)
  ret i32 0
}
