; ModuleID = 'main_module'
source_filename = "main_module"

%Somefunc = type { i32 }

@str.0 = private constant [3 x i8] c"%d\00"

declare i32 @printf(ptr %0, ...)

define i32 @main_Somefunc_something(ptr %0) {
entry:
  %struct_gep = getelementptr inbounds nuw %Somefunc, ptr %0, i32 0, i32 0
  %load = load i32, ptr %struct_gep, align 4
  %add = add i32 %load, 1
  store i32 %add, ptr %struct_gep, align 4
  %struct_gep1 = getelementptr inbounds nuw %Somefunc, ptr %0, i32 0, i32 0
  %load2 = load i32, ptr %struct_gep1, align 4
  ret i32 %load2
}

define %Somefunc @main_thing() {
entry:
  %alloc = alloca %Somefunc, align 8
  %struct_gep = getelementptr inbounds nuw %Somefunc, ptr %alloc, i32 0, i32 0
  store i32 1, ptr %struct_gep, align 4
  %load = load %Somefunc, ptr %alloc, align 4
  ret %Somefunc %load
}

define i32 @main() {
entry:
  %call = call %Somefunc @main_thing()
  %alloc = alloca %Somefunc, align 8
  store %Somefunc %call, ptr %alloc, align 4
  %call1 = call i32 @main_Somefunc_something(ptr %alloc)
  %call2 = call i32 (ptr, ...) @printf(ptr @str.0, i32 %call1)
  ret i32 0
}
