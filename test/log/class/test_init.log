; ModuleID = 'main_module'
source_filename = "main_module"

%Point = type { double, double }

@str.1 = private constant [23 x i8] c"Point(x: %lf, y: %lf)\0A\00"
@str.0 = private constant [27 x i8] c"init called with %lf, %lf\0A\00"

declare i32 @printf(ptr %0, ...)

define void @main_Point_init_f64_f64(ptr %0, double %1, double %2) {
entry:
  %call = call i32 (ptr, ...) @printf(ptr @str.0, double %1, double %2)
  %struct_gep = getelementptr inbounds nuw %Point, ptr %0, i32 0, i32 0
  store double %1, ptr %struct_gep, align 8
  %struct_gep1 = getelementptr inbounds nuw %Point, ptr %0, i32 0, i32 1
  store double %2, ptr %struct_gep1, align 8
  ret void
}

define void @main_Point_print_cords(ptr %0) {
entry:
  %struct_gep = getelementptr inbounds nuw %Point, ptr %0, i32 0, i32 0
  %load = load double, ptr %struct_gep, align 8
  %struct_gep1 = getelementptr inbounds nuw %Point, ptr %0, i32 0, i32 1
  %load2 = load double, ptr %struct_gep1, align 8
  %call = call i32 (ptr, ...) @printf(ptr @str.1, double %load, double %load2)
  ret void
}

define i32 @main() {
entry:
  %alloc = alloca %Point, align 8
  call void @main_Point_init_f64_f64(ptr %alloc, double 5.000000e+00, double 6.500000e+00)
  call void @main_Point_print_cords(ptr %alloc)
  ret i32 0
}
