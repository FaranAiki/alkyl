%string = type { i32, ptr }

@str.0_data = private constant [21 x i8] c"purge: ErrDivByZero\0A\00"
@str.0 = private constant %string { i32 20, ptr @str.0_data }
@div_zero_msg = private unnamed_addr constant [25 x i8] c"purge: ErrDivisionByZero\00", align 1

define { i32, i32 } @main_divbytwo_i32_i32(i32 %0, i32 %1) {
entry:
  %alloc = alloca i32, align 4
  store i32 %0, ptr %alloc, align 4
  %alloc1 = alloca i32, align 4
  store i32 %1, ptr %alloc1, align 4
  %eq = icmp eq i32 %1, 0
  br i1 %eq, label %then, label %merge

then:                                             ; preds = %entry
  ret { i32, i32 } { i32 2, i32 undef }

merge:                                            ; preds = %entry
  %load = load i32, ptr %alloc, align 4
  %load2 = load i32, ptr %alloc1, align 4
  %div_cmp = icmp eq i32 %load2, 0
  br i1 %div_cmp, label %div_zero, label %div_ok

div_ok:                                           ; preds = %merge
  %div = sdiv i32 %load, %load2
  %2 = insertvalue { i32, i32 } { i32 0, i32 undef }, i32 %div, 1
  ret { i32, i32 } %2

div_zero:                                         ; preds = %merge
  %3 = call i32 @puts(ptr @div_zero_msg)
  call void @exit(i32 1)
  unreachable
}

define i32 @main() {
entry:
