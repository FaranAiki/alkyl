; ModuleID = 'main_module'
source_filename = "main_module"

%Person = type { ptr, i32 }
%Identity = type { ptr, i32 }

@str.3 = private constant [11 x i8] c"Faran Aiki\00"
@str.2 = private constant [15 x i8] c"My name is %s\0A\00"
@str.1 = private constant [14 x i8] c"I am %d y.o.\0A\00"
@str.0 = private constant [7 x i8] c"Hello!\00"

declare i32 @printf(ptr %0, ...)

define i32 @main_Person_intro(ptr %0) {
entry:
  %struct_gep = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 1
  %load = load i32, ptr %struct_gep, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.1, i32 %load)
  %struct_gep1 = getelementptr inbounds nuw %Identity, ptr %0, i32 0, i32 0
  %load2 = load ptr, ptr %struct_gep1, align 8
  %call3 = call i32 (ptr, ...) @printf(ptr @str.2, ptr %load2)
  ret i32 1
}

define i32 @main_Person_speak(ptr %0) {
entry:
  %call = call i32 (ptr, ...) @printf(ptr @str.0)
  ret i32 1
}

define void @Person(ptr %0, ptr %1, i32 %2) {
entry:
  %struct_gep = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 0
  store ptr %1, ptr %struct_gep, align 8
  %struct_gep1 = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 1
  store i32 %2, ptr %struct_gep1, align 4
  ret void
}

define i32 @main() {
entry:
  %alloc = alloca %Person, align 8
  call void @Person(ptr %alloc, ptr @str.3, i32 10)
  %call = call i32 @main_Person_speak(ptr %alloc)
  %call1 = call i32 @main_Person_intro(ptr %alloc)
  ret i32 0
}
HINT_CLASS Person
HINT_CLASS Identity
