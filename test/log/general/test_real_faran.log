; ModuleID = 'main_module'
source_filename = "main_module"

%Person = type { ptr, i32 }

@str.12 = private constant [11 x i8] c"Faran Aiki\00"
@str.11 = private constant [12 x i8] c" years old\0A\00"
@str.10 = private constant [11 x i8] c" and I am \00"
@str.9 = private constant [23 x i8] c"Greetings, my name is \00"
@str.8 = private constant [14 x i8] c"I am waving!\0A\00"
@str.1 = private constant [3 x i8] c"%s\00"
@str.0 = private constant [3 x i8] c"%d\00"

declare i32 @printf(ptr %0, ...)

define void @main_Person_wave(ptr %0) {
entry:
  %alloc = alloca i8, i64 8, align 1
  %ptr_gep = getelementptr ptr, ptr %alloc, i32 0
  store ptr @str.8, ptr %ptr_gep, align 8
  %ptr_gep1 = getelementptr ptr, ptr %alloc, i32 0
  %load = load ptr, ptr %ptr_gep1, align 8
  %call = call i32 (ptr, ...) @printf(ptr @str.1, ptr %load)
  ret void
}

define void @main_Person_introduce(ptr %0) {
entry:
  %call = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.9)
  %struct_gep = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 0
  %load = load ptr, ptr %struct_gep, align 8
  %call1 = call i32 (ptr, ...) @printf(ptr @str.1, ptr %load)
  %call2 = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.10)
  %struct_gep3 = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 1
  %load4 = load i32, ptr %struct_gep3, align 4
  %call5 = call i32 (ptr, ...) @printf(ptr @str.0, i32 %load4)
  %call6 = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.11)
  ret void
}

define void @Person(ptr %0, ptr %1, i32 %2) {
entry:
  %struct_gep = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 0
  store ptr %1, ptr %struct_gep, align 8
  %struct_gep1 = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 1
  store i32 %2, ptr %struct_gep1, align 4
  ret void
}

define i32 @main(i32 %0, ptr %1) {
entry:
  %alloc = alloca %Person, align 8
  call void @Person(ptr %alloc, ptr @str.12, i32 19)
  call void @main_Person_wave(ptr %alloc)
  call void @main_Person_introduce(ptr %alloc)
  ret i32 0
}
