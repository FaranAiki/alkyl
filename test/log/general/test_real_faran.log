  %struct_gep = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 0
  %load = load ptr, ptr %struct_gep, align 8
  %call1 = call i32 (ptr, ...) @printf(ptr @str.1, ptr %load)
  %call2 = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.10)
  %struct_gep3 = getelementptr inbounds nuw %Person, ptr %0, i32 0, i32 1
  %load4 = load i32, ptr %struct_gep3, align 4
  %call5 = call i32 (ptr, ...) @printf(ptr @str.0, i32 %load4)
  %call6 = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.11)
  ret void
}

