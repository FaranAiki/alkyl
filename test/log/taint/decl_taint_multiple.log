; ModuleID = 'main_module'
source_filename = "main_module"

@str.0 = private constant [14 x i8] c"x is tainted\0A\00"

declare i32 @printf(ptr %0)

define i32 @main() {
entry:
  %eq = icmp eq i32 inttoptr (i64 10 to i32), 10
  br i1 %eq, label %then, label %merge

then:                                             ; preds = %entry
  %call = call i32 @printf(ptr @str.0)
  br label %merge

merge:                                            ; preds = %then, %entry
  ret i32 0
}
