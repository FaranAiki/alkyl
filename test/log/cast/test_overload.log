; ModuleID = 'main_module'
source_filename = "main_module"

%main.Calculator = type { i32 }

@str.10 = private constant [12 x i8] c"i_res = %d\0A\00"
@str.9 = private constant [19 x i8] c"double add called\0A\00"
@str.8 = private constant [16 x i8] c"int add called\0A\00"
@str.0 = private constant [3 x i8] c"%d\00"

declare i32 @printf(ptr %0, ...)

define i32 @main_Calculator_add_i32_i32(ptr %0, i32 %1, i32 %2) {
entry:
  %call = call i32 (ptr, ...) @printf(ptr @str.8)
  %add = add i32 %1, %2
  ret i32 %add
}

define double @main_Calculator_add_f64_f64(ptr %0, double %1, double %2) {
entry:
  %call = call i32 (ptr, ...) @printf(ptr @str.9)
  %fadd = fadd double %1, %2
  ret double %fadd
}

define void @main.Calculator(ptr %0, i32 %1) {
entry:
  %struct_gep = getelementptr inbounds nuw %main.Calculator, ptr %0, i32 0, i32 0
  store i32 %1, ptr %struct_gep, align 4
  ret void
}

define i32 @main() {
entry:
  %alloc = alloca %main.Calculator, align 8
  call void @main.Calculator(ptr %alloc, i32 0)
  %call = call i32 @main_Calculator_add_i32_i32(ptr %alloc, i32 10, i32 20)
  %call1 = call double @main_Calculator_add_f64_f64(ptr %alloc, double 1.050000e+01, double 2.050000e+01)
  %call2 = call i32 (ptr, ...) @printf(ptr @str.10, i32 %call)
  %call3 = call i32 (ptr, ...) @printf(ptr @str.0, i32 %call)
  ret i32 0
}
