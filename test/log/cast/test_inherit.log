; ModuleID = 'main_module'
source_filename = "main_module"

%A = type { i32, i32 }

@str.0 = private constant [3 x i8] c"%d\00"

declare i32 @printf(ptr %0, ...)

define void @A(ptr %0, i32 %1, i32 %2) {
entry:
  %struct_gep = getelementptr inbounds nuw %A, ptr %0, i32 0, i32 0
  store i32 %1, ptr %struct_gep, align 4
  %struct_gep1 = getelementptr inbounds nuw %A, ptr %0, i32 0, i32 1
  store i32 %2, ptr %struct_gep1, align 4
  ret void
}

define i32 @main() {
entry:
  %alloc = alloca %A, align 8
  call void @A(ptr %alloc, i32 0, i32 0)
  %struct_gep = getelementptr inbounds nuw %A, ptr %alloc, i32 0, i32 0
  store i32 1, ptr %struct_gep, align 4
  %struct_gep1 = getelementptr inbounds nuw %A, ptr %alloc, i32 0, i32 1
  store i32 2, ptr %struct_gep1, align 4
  %struct_gep2 = getelementptr inbounds nuw %A, ptr %alloc, i32 0, i32 1
  %load = load i32, ptr %struct_gep2, align 4
  %struct_gep3 = getelementptr inbounds nuw %A, ptr %alloc, i32 0, i32 0
  %load4 = load i32, ptr %struct_gep3, align 4
  %add = add i32 %load, %load4
  %call = call i32 (ptr, ...) @printf(ptr @str.0, i32 %add)
  ret i32 0
}
