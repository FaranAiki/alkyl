  %load3 = load i32, ptr %struct_gep2, align 4
  %struct_gep4 = getelementptr inbounds nuw %Vector_int, ptr %alloc1, i32 0, i32 1
  %load5 = load i32, ptr %struct_gep4, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.0, i32 %load3, i32 %load5)
  ret i32 0
}

define void @Vector_int(ptr %0, i32 %1, i32 %2) {
entry:
