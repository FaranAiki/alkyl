; ModuleID = 'main_module'
source_filename = "main_module"

%A = type { ptr, i32 }
%B = type { ptr, i32 }

@str.0 = private constant [3 x i8] c"%d\00"

declare i32 @printf(ptr %0, ...)

define void @A(ptr %0, ptr %1, i32 %2) {
entry:
  %struct_gep = getelementptr inbounds nuw %A, ptr %0, i32 0, i32 0
  store ptr %1, ptr %struct_gep, align 8
  %struct_gep1 = getelementptr inbounds nuw %A, ptr %0, i32 0, i32 1
  store i32 %2, ptr %struct_gep1, align 4
  ret void
}

define void @B(ptr %0, ptr %1, i32 %2) {
entry:
  %struct_gep = getelementptr inbounds nuw %B, ptr %0, i32 0, i32 0
  store ptr %1, ptr %struct_gep, align 8
  %struct_gep1 = getelementptr inbounds nuw %B, ptr %0, i32 0, i32 1
  store i32 %2, ptr %struct_gep1, align 4
  ret void
}

define i32 @main() {
entry:
  %alloc = alloca %B, align 8
  call void @B(ptr %alloc, ptr null, i32 20)
  %alloc1 = alloca %A, align 8
  %load = load %B, ptr %alloc, align 8
  call void @A(ptr %alloc1, ptr %alloc, i32 10)
  %struct_gep = getelementptr inbounds nuw %A, ptr %alloc1, i32 0, i32 1
  %load2 = load i32, ptr %struct_gep, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.0, i32 %load2)
  ret i32 0
}
