; ModuleID = 'main_module'
source_filename = "main_module"

@str.1 = private constant [25 x i8] c"rotl = %d (should be 2)\0A\00"
@str.0 = private constant [43 x i8] c"rotr = %d (should be negative -something)\0A\00"

declare i32 @printf(ptr %0, ...)

define i32 @main() {
entry:
  %call = call i32 (ptr, ...) @printf(ptr @str.0, i32 0)
  %call1 = call i32 (ptr, ...) @printf(ptr @str.1, i32 2)
  ret i32 0
}
