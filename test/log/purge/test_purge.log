@str.1 = private constant [4 x i8] c"%d\0A\00"
@str.0_data = private constant [26 x i8] c"purge: ErrDivisionByZero\0A\00"
@str.0 = private constant %string { i32 25, ptr @str.0_data }
@div_zero_msg = private unnamed_addr constant [25 x i8] c"purge: ErrDivisionByZero\00", align 1

