; ModuleID = 'main_module'
source_filename = "main_module"

%string = type { i32, ptr }

@str.4 = private constant [18 x i8] c"Division by zero!\00"
@str.3 = private constant [11 x i8] c"%d and %d\0A\00"
@str.2 = private constant [3 x i8] c"%d\00"
@str.1 = private constant [4 x i8] c"%d\0A\00"
@str.0_data = private constant [26 x i8] c"purge: ErrDivisionByZero\0A\00"
@str.0 = private constant %string { i32 25, ptr @str.0_data }
@div_zero_msg = private unnamed_addr constant [25 x i8] c"purge: ErrDivisionByZero\00", align 1

declare i32 @printf(ptr %0, ...)

define { i32, i32 } @main_divide_i32_i32(i32 %0, i32 %1) {
entry:
  %alloc = alloca i32, align 4
  store i32 %0, ptr %alloc, align 4
  %alloc1 = alloca i32, align 4
  store i32 %1, ptr %alloc1, align 4
  %eq = icmp eq i32 %1, 0
  br i1 %eq, label %then, label %merge

then:                                             ; preds = %entry
  ret { i32, i32 } { i32 2, i32 undef }

merge:                                            ; preds = %entry
  %load = load i32, ptr %alloc, align 4
  %load2 = load i32, ptr %alloc1, align 4
  %div_cmp = icmp eq i32 %load2, 0
  br i1 %div_cmp, label %div_zero, label %div_ok

div_ok:                                           ; preds = %merge
  %div = sdiv i32 %load, %load2
  %2 = insertvalue { i32, i32 } { i32 0, i32 undef }, i32 %div, 1
  ret { i32, i32 } %2

div_zero:                                         ; preds = %merge
  %3 = call i32 @puts(ptr @div_zero_msg)
  call void @exit(i32 1)
  unreachable
}

define i32 @main() {
entry:
  %call = call { i32, i32 } @main_divide_i32_i32(i32 10, i32 2)
  %alloc = alloca { i32, i32 }, align 8
  store { i32, i32 } %call, ptr %alloc, align 4
  %call1 = call { i32, i32 } @main_divide_i32_i32(i32 10, i32 0)
  %alloc2 = alloca { i32, i32 }, align 8
  store { i32, i32 } %call1, ptr %alloc2, align 4
  %alloc3 = alloca i32, align 4
  %taint_gep = getelementptr inbounds nuw { i32, i32 }, ptr %alloc, i32 0, i32 0
  %load = load i32, ptr %taint_gep, align 4
  %taint_gep4 = getelementptr inbounds nuw { i32, i32 }, ptr %alloc, i32 0, i32 1
  %load5 = load i32, ptr %taint_gep4, align 4
  store i32 %load5, ptr %alloc3, align 4
  %eq = icmp eq i32 %load, 0
  br i1 %eq, label %untaint_merge, label %untaint_merge

untaint_merge:                                    ; preds = %entry, %entry
  %load6 = load i32, ptr %alloc3, align 4
  %call7 = call i32 (ptr, ...) @printf(ptr @str.1, i32 %load6)
  %alloc8 = alloca i32, align 4
  %taint_gep9 = getelementptr inbounds nuw { i32, i32 }, ptr %alloc2, i32 0, i32 0
  %load10 = load i32, ptr %taint_gep9, align 4
  %taint_gep11 = getelementptr inbounds nuw { i32, i32 }, ptr %alloc2, i32 0, i32 1
  %load12 = load i32, ptr %taint_gep11, align 4
  store i32 %load12, ptr %alloc8, align 4
  %eq13 = icmp eq i32 %load10, 0
  br i1 %eq13, label %clean_then, label %clean_residue

clean_then:                                       ; preds = %untaint_merge
  %load14 = load i32, ptr %alloc8, align 4
  %add = add i32 %load14, 1
  store i32 %add, ptr %alloc8, align 4
  %call15 = call i32 (ptr, ...) @printf(ptr @str.2, i32 %add)
  br label %clean_merge

clean_residue:                                    ; preds = %untaint_merge
  %call16 = call i32 (ptr, ...) @printf(ptr @str.3, i32 %load10, i32 2)
  %eq17 = icmp eq i32 %load10, 2
  br i1 %eq17, label %then, label %clean_merge

clean_merge:                                      ; preds = %then, %clean_residue, %clean_then
  %load18 = load { i32, i32 }, ptr %alloc2, align 4
  %load19 = load { i32, i32 }, ptr %alloc2, align 4
  %err_id = extractvalue { i32, i32 } %load19, 0
  %val = extractvalue { i32, i32 } %load19, 1
  %has_target_err = icmp eq i32 %err_id, 1
  %new_err_id = select i1 %has_target_err, i32 0, i32 %err_id
  %new_val = select i1 %has_target_err, i32 2, i32 %val
  %ins_err = insertvalue { i32, i32 } undef, i32 %new_err_id, 0
  %ins_val = insertvalue { i32, i32 } %ins_err, i32 %new_val, 1
  %err_id20 = extractvalue { i32, i32 } %ins_val, 0
  %val21 = extractvalue { i32, i32 } %ins_val, 1
  %has_err = icmp ne i32 %err_id20, 0
  %fallback_res = select i1 %has_err, i32 3, i32 %val21
  %call22 = call i32 (ptr, ...) @printf(ptr @str.1, i32 %fallback_res)
  ret i32 0

then:                                             ; preds = %clean_residue
  %call23 = call i32 (ptr, ...) @printf(ptr @str.4)
  br label %clean_merge

merge:                                            ; preds = %merge
  br label %merge
}

declare i32 @puts(ptr %0)

declare void @exit(i32 %0)
