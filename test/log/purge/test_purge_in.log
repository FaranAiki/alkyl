; ModuleID = 'main_module'
source_filename = "main_module"

@str.0 = private constant [12 x i8] c"It worked!\0A\00"

declare i32 @printf(ptr %0, ...)

define { i32, i32 } @main() {
entry:
  %alloc = alloca { i32, i32 }, align 8
  store { i32, i32 } zeroinitializer, ptr %alloc, align 4
  %taint_gep = getelementptr inbounds nuw { i32, i32 }, ptr %alloc, i32 0, i32 0
  store i32 1, ptr %taint_gep, align 4
  %load = load { i32, i32 }, ptr %alloc, align 4
  %load1 = load { i32, i32 }, ptr %alloc, align 4
  %err_id = extractvalue { i32, i32 } %load1, 0
  %val = extractvalue { i32, i32 } %load1, 1
  %has_err = icmp ne i32 %err_id, 0
  %fallback_res = select i1 %has_err, i32 2, i32 %val
  %trunc_cond = trunc i32 %fallback_res to i1
  br i1 %trunc_cond, label %then, label %merge

then:                                             ; preds = %entry
  %call = call i32 (ptr, ...) @printf(ptr @str.0)
  br label %merge

merge:                                            ; preds = %then, %entry
  ret { i32, i32 } zeroinitializer
}
