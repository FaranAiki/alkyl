; ModuleID = 'main_module'
source_filename = "main_module"

@str.1 = private constant [8 x i8] c"%d: %d\0A\00"
@str.0 = private constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr %0, ...)

define i32 @main() {
entry:
  %alloc = alloca i32, align 4
  store i32 0, ptr %alloc, align 4
  br label %while_cond

while_cond:                                       ; preds = %while_body, %entry
  %load = load i32, ptr %alloc, align 4
  %lt = icmp slt i32 %load, 10
  br i1 %lt, label %while_body, label %while_end

while_body:                                       ; preds = %while_cond
  %load1 = load i32, ptr %alloc, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.0, i32 %load1)
  %load2 = load i32, ptr %alloc, align 4
  %add = add i32 %load2, 1
  store i32 %add, ptr %alloc, align 4
  br label %while_cond

while_end:                                        ; preds = %while_cond
  %alloc3 = alloca i32, align 4
  store i32 0, ptr %alloc3, align 4
  br label %while_cond_2

while_cond_2:                                     ; preds = %while_body_2, %while_end
  %load4 = load i32, ptr %alloc, align 4
  %eq = icmp eq i32 %load4, 10
  br i1 %eq, label %while_body_2, label %while_end_2

while_body_2:                                     ; preds = %while_cond_2
  %load5 = load i32, ptr %alloc3, align 4
  %add6 = add i32 %load5, 1
  store i32 %add6, ptr %alloc3, align 4
  %load7 = load i32, ptr %alloc, align 4
  %call8 = call i32 (ptr, ...) @printf(ptr @str.1, i32 %load7, i32 %add6)
  %gt = icmp sgt i32 %add6, 10
  br i1 %gt, label %while_end_2, label %while_cond_2

while_end_2:                                      ; preds = %while_body_2, %while_cond_2
  ret i32 0

then:                                             ; preds = %then
  br label %then

merge:                                            ; preds = %merge
  br label %merge
}
