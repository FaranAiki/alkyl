declare i32 @printf(ptr %0, ...)

define i32 @main_recurse_me_i32(i32 %0) {
entry:
  %alloc = alloca i32, align 4
  store i32 %0, ptr %alloc, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.8)
  %call1 = call i32 (ptr, ...) @printf(ptr @str.0, i32 %0)
  %call2 = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.9)
