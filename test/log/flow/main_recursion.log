declare i32 @printf(ptr %0, ...)

define i32 @main(i32 %0, ptr %1) {
entry:
  %alloc = alloca i32, align 4
  store i32 %0, ptr %alloc, align 4
  %alloc1 = alloca ptr, align 8
  store ptr %1, ptr %alloc1, align 8
