  %call = call i32 (ptr, ...) @printf(ptr @str.1, ptr %load)
  %call2 = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.8)
  %eq = icmp eq i32 %0, 1
  br i1 %eq, label %then, label %merge

then:                                             ; preds = %entry
  ret i32 0

merge:                                            ; preds = %entry
