source_filename = "main_module"

@str.8 = private constant [2 x i8] c"\0A\00"
@str.1 = private constant [3 x i8] c"%s\00"

declare i32 @printf(ptr %0, ...)

define i32 @main(i32 %0, ptr %1) {
entry:
  %alloc = alloca i32, align 4
  store i32 %0, ptr %alloc, align 4
  %alloc1 = alloca ptr, align 8
  store ptr %1, ptr %alloc1, align 8
  %sub = sub i32 %0, 1
  %ptr_gep = getelementptr ptr, ptr %1, i32 %sub
  %load = load ptr, ptr %ptr_gep, align 8
  %call = call i32 (ptr, ...) @printf(ptr @str.1, ptr %load)
  %call2 = call i32 (ptr, ...) @printf(ptr @str.1, ptr @str.8)
  %eq = icmp eq i32 %0, 1
  br i1 %eq, label %then, label %merge

then:                                             ; preds = %entry
  ret i32 0

merge:                                            ; preds = %entry
  %load3 = load i32, ptr %alloc, align 4
  %sub4 = sub i32 %load3, 1
  %load5 = load ptr, ptr %alloc1, align 8
  %call6 = call i32 @main(i32 %sub4, ptr %load5)
  ret i32 0
}
