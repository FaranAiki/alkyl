 - ns.Clib fields: 1
; ModuleID = 'main_module'
source_filename = "main_module"

%ns.Clib = type { i32 }

define i32 @main() {
entry:
  %alloc = alloca %ns.Clib, align 8
  %struct_gep = getelementptr inbounds nuw %ns.Clib, ptr %alloc, i32 0, i32 0
  store i32 1, ptr %struct_gep, align 4
  %struct_gep1 = getelementptr inbounds nuw %ns.Clib, ptr %alloc, i32 0, i32 0
  %load = load i32, ptr %struct_gep1, align 4
  %eq = icmp eq i32 %load, 1
  br i1 %eq, label %then, label %merge

then:                                             ; preds = %entry
  ret i32 0

merge:                                            ; preds = %entry
  ret i32 1
}
