}

define i32 @main_square_int_i32(i32 %0) {
entry:
  %mul = mul i32 %0, %0
  ret i32 %mul
}

define double @main_square_double_f64(double %0) {
entry:
  %fmul = fmul double %0, %0
  ret double %fmul
}
