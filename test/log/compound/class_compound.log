; ModuleID = 'main_module'
source_filename = "main_module"

%Vector_int = type { i32, i32 }

@str.1 = private constant [14 x i8] c"distance: %d\0A\00"
@str.0 = private constant [15 x i8] c"x & y: %d, %d\0A\00"

declare i32 @printf(ptr %0, ...)

define i32 @main() {
entry:
  %alloc = alloca %Vector_int, align 8
  call void @Vector_int(ptr %alloc, i32 10, i32 10)
  %struct_gep = getelementptr inbounds nuw %Vector_int, ptr %alloc, i32 0, i32 0
  %load = load i32, ptr %struct_gep, align 4
  %struct_gep1 = getelementptr inbounds nuw %Vector_int, ptr %alloc, i32 0, i32 1
  %load2 = load i32, ptr %struct_gep1, align 4
  %call = call i32 (ptr, ...) @printf(ptr @str.0, i32 %load, i32 %load2)
  %call3 = call i32 @main_Vector_int_distance_square(ptr %alloc)
  %call4 = call i32 (ptr, ...) @printf(ptr @str.1, i32 %call3)
  ret i32 0
}

define i32 @main_Vector_int_distance_square(ptr %0) {
entry:
  %struct_gep = getelementptr inbounds nuw %Vector_int, ptr %0, i32 0, i32 0
  %load = load i32, ptr %struct_gep, align 4
  %struct_gep1 = getelementptr inbounds nuw %Vector_int, ptr %0, i32 0, i32 0
  %load2 = load i32, ptr %struct_gep1, align 4
  %mul = mul i32 %load, %load2
  %struct_gep3 = getelementptr inbounds nuw %Vector_int, ptr %0, i32 0, i32 1
  %load4 = load i32, ptr %struct_gep3, align 4
  %struct_gep5 = getelementptr inbounds nuw %Vector_int, ptr %0, i32 0, i32 1
  %load6 = load i32, ptr %struct_gep5, align 4
  %mul7 = mul i32 %load4, %load6
  %add = add i32 %mul, %mul7
  ret i32 %add
}

define void @Vector_int(ptr %0, i32 %1, i32 %2) {
entry:
  %struct_gep = getelementptr inbounds nuw %Vector_int, ptr %0, i32 0, i32 0
  store i32 %1, ptr %struct_gep, align 4
  %struct_gep1 = getelementptr inbounds nuw %Vector_int, ptr %0, i32 0, i32 1
  store i32 %2, ptr %struct_gep1, align 4
  ret void
}
